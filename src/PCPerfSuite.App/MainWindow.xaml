<Window x:Class="PCPerfSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCPerfSuite.App.Views"
        xmlns:controls="clr-namespace:PCPerfSuite.App.Controls"
        xmlns:vm="clr-namespace:PCPerfSuite.App.ViewModels"
        Title="PCPerfSuite" Height="820" Width="1280" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen" Icon="PCPerfSuite.ico">

    <Window.Resources>
        <!-- Menu de l'icône de la zone de notification. Déclaré ici pour hériter du style implicite
             de Styles/Menus.xaml, comme tous les autres menus de l'app. -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Afficher PCPerfSuite" FontWeight="SemiBold" Click="OnTrayShow"/>
            <Separator/>
            <MenuItem Header="Quitter" Click="OnTrayQuit"/>
        </ContextMenu>

        <!-- Entrées de la barre latérale rangées sous leur section. Les groupes suivent l'ordre de NavigationMenu.Pages ;
             une section sans page n'a pas de groupe, donc pas d'en-tête. -->
        <CollectionViewSource x:Key="NavSections" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="SectionTitle"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <!-- Lueur décorative derrière le verre (visible surtout si Mica/Acrylic natif n'est pas
             disponible sur ce Windows ; sinon vient s'ajouter au flou natif du bureau). -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.05" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="{StaticResource AccentGlowColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource AccentGlowFadeColor}" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marque : l'icône de l'app + son nom. L'icône elle-même, et non un glyphe dans une
                     pastille dégradée : c'est la même image que la barre de titre, la barre des tâches et
                     la zone de notification, donc on reconnaît l'app partout pareil.
                     DecodePixelWidth pousse le décodeur ICO vers une trame bien plus grande que 36 px, pour
                     que le logo reste net à 150 % et 200 % d'échelle d'affichage.
                     Marges serrées, comme celles du pied : à 820 px de haut, en administrateur, tout le menu d'un PC
                     de bureau tient sans défiler (calcul dans docs/navigation.md). -->
                <Grid DockPanel.Dock="Top" Margin="20,16,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="/PCPerfSuite.ico" DecodePixelWidth="72"/>
                        </Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PCPerfSuite" Style="{StaticResource H2}" FontSize="16"/>
                        <TextBlock Text="Monitoring &amp; tuning" Style="{StaticResource Caption}" FontSize="11.5"/>
                    </StackPanel>
                </Grid>

                <!-- Pied : Paramètres de l'app, puis état des droits. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
                    <!-- Hors de la liste : Tag porte son état actif (voir NavButton). Il clignote tant qu'un logiciel
                         externe manque (PawnIO, RTSS), et son info-bulle dit lequel et pourquoi. -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAppSettingsCommand}"
                            Content="{Binding AppSettingsNav}" Tag="{Binding IsAppSettingsSelected}" Margin="0,0,0,10"
                            controls:Attention.IsBlinking="{Binding IsAppSettingsBlinking}"
                            ToolTip="{Binding AppSettingsToolTip}"/>
                    <StackPanel Margin="14,0">
                    <Border Style="{StaticResource CalloutWarn}"
                            Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Droits limités" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock Text="Relance en administrateur pour débloquer tous les capteurs et réglages."
                                           Style="{StaticResource Caption}" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Administrateur" Style="{StaticResource Caption}" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- IsSynchronizedWithCurrentItem à False : la sélection suit SelectedNavItem seul (null quand les
                     Paramètres sont affichés), pas l'élément courant de la vue groupée. CanContentScroll à False : avec
                     des groupes, le défilement élément par élément sauterait des sections entières ; au pixel, il reste
                     fluide quand la fenêtre est trop basse pour tout montrer. -->
                <ListBox ItemsSource="{Binding Source={StaticResource NavSections}}" SelectedItem="{Binding SelectedNavItem}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource NavPageItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource NavSectionHeader}"/>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenu : chaque vue est instanciée une seule fois pour la durée de vie de l'app (au lieu
             d'un ContentControl qui détruirait/recréerait la vue — et donc les Sparkline du Monitoring
             avec leur historique — à chaque changement d'onglet) ; seule sa Visibility change. Chaque vue se montre
             d'après la CLÉ de la page courante (PageKeys), jamais d'après son titre : renommer une page ne la casse plus. -->
        <Grid Grid.Column="1">
            <views:MonitoringView DataContext="{Binding Monitoring}"
                                  Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Monitoring}}"/>
            <views:ProcessesView DataContext="{Binding Processes}"
                                 Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Processes}}"/>
            <views:OverlayView DataContext="{Binding Overlay}"
                               Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Overlay}}"/>
            <views:CpuControlView DataContext="{Binding Cpu}"
                                  Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Cpu}}"/>
            <views:GpuControlView DataContext="{Binding Gpu}"
                                  Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Gpu}}"/>
            <views:FanCurvesView DataContext="{Binding Fans}"
                                 Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Fans}}"/>
            <views:OptimizationView DataContext="{Binding Optimization}"
                                    Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Optimization}}"/>
            <views:CleanupView DataContext="{Binding Cleanup}"
                               Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Cleanup}}"/>
            <views:StorageView DataContext="{Binding Storage}"
                               Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Storage}}"/>
            <views:ToolboxView DataContext="{Binding Toolbox}"
                               Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Toolbox}}"/>
            <views:AppSettingsView DataContext="{Binding AppSettings}"
                                   Visibility="{Binding DataContext.CurrentPage.Key, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter={x:Static vm:PageKeys.Settings}}"/>

            <!-- Toutes les pages pas encore livrées partagent cette vue : elle n'a pas d'état à garder, son contenu suit
                 la page choisie, et elle disparaît (DataContext null) sur une vraie page. -->
            <views:ComingSoonView DataContext="{Binding CurrentPage.ComingSoon}"
                                  Visibility="{Binding DataContext.CurrentPage.ComingSoon, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
