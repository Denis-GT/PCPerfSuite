<Window x:Class="PCPerfSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCPerfSuite.App.ViewModels"
        xmlns:views="clr-namespace:PCPerfSuite.App.Views"
        Title="PCPerfSuite" Height="820" Width="1280" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <views:StorageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FanCurvesViewModel}">
            <views:FanCurvesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpuControlViewModel}">
            <views:GpuControlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlayViewModel}">
            <views:OverlayView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
            <views:ComingSoonView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Lueur décorative derrière le verre (visible surtout si Mica/Acrylic natif n'est pas
             disponible sur ce Windows ; sinon vient s'ajouter au flou natif du bureau). -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.05" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#332A84FF" Offset="0"/>
                    <GradientStop Color="#00161A28" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="PCPerfSuite" Style="{StaticResource H1}" FontSize="19"/>
                    <TextBlock Text="Monitoring &amp; tuning PC" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="14,10" Margin="8,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#332A84FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" Padding="12" CornerRadius="8"
                        Background="{StaticResource SurfaceAltBrush}"
                        Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Droits limités" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="Relance en administrateur pour débloquer tous les capteurs et réglages."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
