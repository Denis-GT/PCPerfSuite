<Window x:Class="PCPerfSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCPerfSuite.App.Views"
        Title="PCPerfSuite" Height="820" Width="1280" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Lueur décorative derrière le verre (visible surtout si Mica/Acrylic natif n'est pas
             disponible sur ce Windows ; sinon vient s'ajouter au flou natif du bureau). -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.05" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="{StaticResource AccentGlowColor}" Offset="0"/>
                    <GradientStop Color="#00161A28" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marque : pastille dégradée + nom. -->
                <Grid DockPanel.Dock="Top" Margin="20,24,16,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PCPerfSuite" Style="{StaticResource H2}" FontSize="16"/>
                        <TextBlock Text="Monitoring &amp; tuning" Style="{StaticResource Caption}" FontSize="11.5"/>
                    </StackPanel>
                </Grid>

                <!-- Pied : état des droits. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                    <Border Style="{StaticResource CalloutWarn}"
                            Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Droits limités" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock Text="Relance en administrateur pour débloquer tous les capteurs et réglages."
                                           Style="{StaticResource Caption}" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Administrateur" Style="{StaticResource Caption}" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- Contenu : chaque vue est instanciée une seule fois pour la durée de vie de l'app (au lieu
             d'un ContentControl qui détruirait/recréerait la vue — et donc les Sparkline du Monitoring
             avec leur historique — à chaque changement d'onglet) ; seule sa Visibility change. -->
        <Grid Grid.Column="1">
            <views:MonitoringView DataContext="{Binding Monitoring}"
                                  Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Monitoring}"/>
            <views:ProcessesView DataContext="{Binding Processes}"
                                 Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Processus}"/>
            <views:CleanupView DataContext="{Binding Cleanup}"
                               Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Nettoyage}"/>
            <views:StorageView DataContext="{Binding Storage}"
                               Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Stockage}"/>
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter='Paramètres Windows'}"/>
            <views:FanCurvesView DataContext="{Binding Fans}"
                                 Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Ventilateurs}"/>
            <views:GpuControlView DataContext="{Binding Gpu}"
                                  Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=GPU}"/>
            <views:OverlayView DataContext="{Binding Overlay}"
                               Visibility="{Binding DataContext.SelectedNavItem.Title, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Overlay}"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
