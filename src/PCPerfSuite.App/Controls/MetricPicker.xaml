<UserControl x:Class="PCPerfSuite.App.Controls.MetricPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext : MetricSelectionViewModel. CheckBox volontairement sans style local (style global du thème). -->
    <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Width="240" Margin="0,0,16,14">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" FontSize="12" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Métrique que ce PC ne fournit pas : toujours cochable, mais signalée (et expliquée
                                     au survol) pour qu'on sache d'avance qu'elle affichera "N/D". -->
                                <CheckBox x:Name="Option" IsChecked="{Binding IsSelected}" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Non disponible sur ce PC" Style="{StaticResource Caption}" FontSize="11"
                                                   Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </CheckBox>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter TargetName="Option" Property="Opacity" Value="0.55"/>
                                        <Setter TargetName="Option" Property="ToolTip" Value="{Binding UnavailableHint}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
