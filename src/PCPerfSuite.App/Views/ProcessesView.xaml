<UserControl x:Class="PCPerfSuite.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <!-- Pas de ScrollViewer racine, contrairement aux autres onglets : il donnerait une hauteur infinie à la
         liste, qui réaliserait alors ses quatre cents lignes d'un coup et perdrait toute virtualisation. La
         liste occupe une ligne de hauteur « * » et défile elle-même. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Processus" Margin="0,0,0,18"
                             Subtitle="Ce qui tourne vraiment — trié sans que les lignes sautent : le classement suit une moyenne sur quelques secondes et se fige dès que la souris entre dans la liste."/>

        <!-- Barre d'outils -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="260" Margin="0,0,14,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBox}" Padding="28,7,8,7"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <!-- Faux texte d'invite : un TextBox WPF n'en a pas, et le superposer évite d'en dériver un. -->
                <TextBlock Text="Rechercher un processus (Ctrl+F)" Style="{StaticResource Caption}" Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SearchText.Length, Converter={StaticResource ZeroCountToVisibility}}"/>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}" VerticalAlignment="Center">
                <ListBox Style="{StaticResource PillSelector}"
                         ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                         DisplayMemberPath="Label"/>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Relevé" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <!-- Liste déroulante plutôt que pilules : cinq cadences alignées prenaient toute la barre
                     d'outils pour un réglage qu'on touche deux fois par session. -->
                <ComboBox Width="96" VerticalAlignment="Center" Margin="0,0,10,0"
                          ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding SelectedRefresh}"
                          ItemTemplate="{StaticResource LabelOptionTemplate}">
                    <ComboBox.ToolTip>
                        <StackPanel MaxWidth="320">
                            <TextBlock Text="{Binding ReadDurationHint}" TextWrapping="Wrap"/>
                            <TextBlock Text="0,5 s sert à attraper une pointe courte : un relevé complet coûte déjà plusieurs dizaines de millisecondes, ce n'est pas une cadence à laisser tourner en fond."
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ComboBox.ToolTip>
                </ComboBox>

                <!-- Un bouton, pas un interrupteur : c'est une action qu'on déclenche puis qu'on annule.
                     Les deux états se superposent dans une Grid, ce qui fige la largeur du bouton — sinon
                     la barre d'outils se réorganiserait à chaque clic. -->
                <ToggleButton Style="{StaticResource ToggleActionButton}" IsChecked="{Binding IsFrozen}" VerticalAlignment="Center"
                              ToolTip="Arrête complètement les relevés, pour lire ou copier tranquillement. Cliquer à nouveau pour reprendre.">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsFrozen, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Figer" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Figé" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToggleActionButton}" IsChecked="{Binding ShowDetails}"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="Affiche sous la liste le détail du processus sélectionné, avec ses courbes de CPU et de mémoire.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Détails" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Button Style="{StaticResource GhostButton}" Margin="14,0,0,0"
                        Command="{Binding ToggleColumnsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Colonnes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Terminer" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                        Command="{Binding TerminateSelectionCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding HeaderSummary, Mode=OneWay}"/>
            <Run Text="{Binding FrozenAtDisplay, Mode=OneWay}" Foreground="{StaticResource WarnBrush}"/>
        </TextBlock>

        <!-- Choix des colonnes -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding IsChoosingColumns, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Colonnes affichées" Style="{StaticResource H2}"/>
                <ItemsControl ItemsSource="{Binding Columns.All}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" Width="150" Margin="0,3,16,3"
                                      IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBoolean}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- La liste -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8,6">
            <DockPanel>
                <!-- En-tête : mêmes largeurs de colonnes que les lignes, pilotées par le ViewModel. -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Padding="0,2,0,4" Margin="0,0,0,4">
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Columns.Name.Width}" MinWidth="200"/>
                        <ColumnDefinition Width="{Binding Columns.Pid.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Kind.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Cpu.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Memory.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Io.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Threads.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.User.Width}"/>
                        <ColumnDefinition Width="{Binding Columns.Publisher.Width}"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Name.HeaderDisplay}"
                            Visibility="{Binding Columns.Name.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Name.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="name"/>
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Pid.HeaderDisplay}"
                            Visibility="{Binding Columns.Pid.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Pid.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="pid"/>
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Kind.HeaderDisplay}"
                            Visibility="{Binding Columns.Kind.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Kind.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="kind"/>
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Cpu.HeaderDisplay}"
                            Visibility="{Binding Columns.Cpu.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Cpu.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="cpu"/>
                    <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Memory.HeaderDisplay}"
                            Visibility="{Binding Columns.Memory.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Memory.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="memory"/>
                    <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Io.HeaderDisplay}"
                            Visibility="{Binding Columns.Io.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Io.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="io"
                            ToolTip="Toutes les entrées/sorties du processus : fichiers, réseau, tubes — comme la colonne du Gestionnaire des tâches"/>
                    <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Threads.HeaderDisplay}"
                            Visibility="{Binding Columns.Threads.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Threads.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="threads"/>
                    <Button Grid.Column="7" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.User.HeaderDisplay}"
                            Visibility="{Binding Columns.User.CellVisibility}" HorizontalContentAlignment="{Binding Columns.User.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="user"/>
                    <Button Grid.Column="8" Style="{StaticResource ColumnHeaderButton}" Content="{Binding Columns.Publisher.HeaderDisplay}"
                            Visibility="{Binding Columns.Publisher.CellVisibility}" HorizontalContentAlignment="{Binding Columns.Publisher.ContentAlignment}"
                            Command="{Binding SortByCommand}" CommandParameter="publisher"/>
                </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="6,8,0,2"
                           Text="Aucun processus ne correspond à la recherche."
                           Visibility="{Binding VisibleCount, Converter={StaticResource ZeroCountToVisibility}}"/>

                <!-- Le style des lignes est déclaré plus bas en ItemContainerStyle : il dérive de ListRowItem
                     et y ajoute la liaison de sélection et le menu contextuel. -->
                <ListBox x:Name="List" ItemsSource="{Binding RowsView}" SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         SelectedItem="{Binding SelectedRow}"
                         MouseEnter="OnListMouseEnter" MouseLeave="OnListMouseLeave"
                         IsKeyboardFocusWithinChanged="OnListKeyboardFocusWithinChanged"
                         PreviewMouseRightButtonDown="OnListRightButtonDown"
                         ContextMenuOpening="OnListContextMenuOpening"
                         KeyDown="OnListKeyDown">
                    <!-- Groupes Applications / Arrière-plan / Windows, posés par le ViewModel au seul tri par
                         nom. IsVirtualizingWhenGrouping ci-dessus n'est pas décoratif : par défaut WPF coupe la
                         virtualisation dès qu'une vue est groupée, et les quatre cents lignes seraient toutes
                         réalisées. Le gabarit du GroupItem ne contient donc que son en-tête et un
                         ItemsPresenter, et son panneau reste un VirtualizingStackPanel — tout emballage
                         supplémentaire casserait la mesure et ramènerait le problème. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel x:Name="Root">
                                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                            Margin="6,10,10,4" Padding="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" FontSize="11.5"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Style="{StaticResource Eyebrow}"
                                                                       FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Margin="6,0,0,0" Typography.NumeralAlignment="Tabular"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <!-- Les trois groupes sont déclarés d'avance par le ViewModel pour fixer leur
                                                         ordre : celui qui n'a aucun processus (un PC sans rien en arrière-plan,
                                                         une recherche qui ne laisse que des applications) ne doit pas afficher
                                                         un en-tête « (0) » tout seul. -->
                                                    <DataTrigger Binding="{Binding ItemCount}" Value="0">
                                                        <Setter TargetName="Root" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Hauteur fixe : le défilement au pixel reste fluide et la liste sait estimer sa
                                 taille sans réaliser les lignes hors écran. -->
                            <Grid Height="26" Background="Transparent"
                                  Opacity="{Binding IsGone, Converter={StaticResource DimOpacity}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Name.Width}" MinWidth="200"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Pid.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Kind.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Cpu.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Memory.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Io.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Threads.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.User.Width}"/>
                                    <ColumnDefinition Width="{Binding Owner.Columns.Publisher.Width}"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icône du fichier à gauche du nom : dans quatre cents lignes, une icône se
                                     reconnaît bien plus vite qu'un nom. Elle arrive en arrière-plan ; tant
                                     qu'elle manque — processus protégé, chemin illisible, ou icône pas encore
                                     lue — un glyphe neutre tient la place pour que les noms restent alignés. -->
                                <Grid Grid.Column="0" Margin="6,0,10,0"
                                      Visibility="{Binding Owner.Columns.Name.CellVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <!-- Gouttière du chevron : réservée sur TOUTES les lignes, qu'elles
                                             en portent un ou non, pour que les icônes restent alignées. -->
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Chevron d'un agrégat. Un bouton plat : le clic ne doit pas être pris
                                         par la sélection de la ligne, sans quoi déplier changerait aussi ce
                                         que « Terminer » vise. -->
                                    <Button x:Name="Expander" Grid.Column="0" Style="{StaticResource ColumnHeaderButton}"
                                            Padding="0" Width="16" HorizontalContentAlignment="Center"
                                            Command="{Binding ToggleExpandCommand}" Visibility="Collapsed"
                                            ToolTip="Déplier ou replier les processus de cette application">
                                        <TextBlock Text="{Binding ExpanderGlyph}" Style="{StaticResource Icon}" FontSize="10"/>
                                    </Button>

                                    <!-- Décalage des membres d'un groupe : c'est le seul repère qui rattache
                                         visuellement un processus à la ligne qui le totalise. -->
                                    <Border x:Name="MemberIndent" Grid.Column="1" Width="0"/>

                                    <Image Grid.Column="2" Source="{Binding Icon}" Width="16" Height="16"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="FallbackGlyph" Grid.Column="2" Text="&#xE7C4;" Style="{StaticResource Icon}"
                                               FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" Visibility="Collapsed"/>

                                    <TextBlock Grid.Column="3" Style="{StaticResource Body}" FontSize="12.5"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="8,0,0,0" ToolTip="{Binding PathDisplay}">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run
                                            Text="{Binding MemberCountDisplay, Mode=OneWay}"
                                            Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding PidDisplay}" Style="{StaticResource Caption}" FontSize="12.5"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Typography.NumeralAlignment="Tabular"
                                           Visibility="{Binding Owner.Columns.Pid.CellVisibility}"/>

                                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Caption}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Owner.Columns.Kind.CellVisibility}"/>

                                <!-- Les quatre valeurs mesurées sont posées sur une pastille bleue d'autant plus marquée
                                     qu'elle pèse lourd (voir CpuIntensity & co. dans ProcessRowViewModel) : les gros
                                     consommateurs se repèrent sans lire les chiffres. -->
                                <Border Grid.Column="3" CornerRadius="4" Margin="2,2,4,2"
                                        Background="{Binding CpuIntensity, Converter={StaticResource IntensityBrush}}"
                                        Visibility="{Binding Owner.Columns.Cpu.CellVisibility}">
                                    <TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource Body}" FontSize="12.5"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>

                                <Border Grid.Column="4" CornerRadius="4" Margin="2,2,4,2"
                                        Background="{Binding MemoryIntensity, Converter={StaticResource IntensityBrush}}"
                                        Visibility="{Binding Owner.Columns.Memory.CellVisibility}">
                                    <TextBlock Text="{Binding MemoryDisplay}" Style="{StaticResource Body}" FontSize="12.5"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>

                                <Border Grid.Column="5" CornerRadius="4" Margin="2,2,4,2"
                                        Background="{Binding IoIntensity, Converter={StaticResource IntensityBrush}}"
                                        Visibility="{Binding Owner.Columns.Io.CellVisibility}">
                                    <TextBlock Text="{Binding IoDisplay}" Style="{StaticResource Body}" FontSize="12.5"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>

                                <Border Grid.Column="6" CornerRadius="4" Margin="2,2,4,2"
                                        Background="{Binding ThreadIntensity, Converter={StaticResource IntensityBrush}}"
                                        Visibility="{Binding Owner.Columns.Threads.CellVisibility}">
                                    <TextBlock Text="{Binding ThreadsDisplay}" Style="{StaticResource Body}" FontSize="12.5"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>

                                <TextBlock Grid.Column="7" Text="{Binding UserName}" Style="{StaticResource Caption}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Owner.Columns.User.CellVisibility}"/>

                                <TextBlock Grid.Column="8" Text="{Binding Publisher}" Style="{StaticResource Caption}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Owner.Columns.Publisher.CellVisibility}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAggregate}" Value="True">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMember}" Value="True">
                                    <Setter TargetName="MemberIndent" Property="Width" Value="18"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRowItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <!-- Le menu vit dans son propre popup, hors de l'arbre visuel. Sa cible n'est
                                         volontairement PAS liée à PlacementTarget.DataContext : le conteneur de la
                                         ligne peut être recyclé pour une autre ligne pendant que le menu est ouvert
                                         (VirtualizationMode="Recycling"), et une liaison vivante suivrait ce
                                         changement — « Terminer… » viserait alors un autre processus que celui sur
                                         lequel on a fait clic droit. Le code-behind fige la cible à l'ouverture. -->
                                    <ContextMenu>
                                        <MenuItem Header="Ouvrir l'emplacement du fichier" Command="{Binding OpenLocationCommand}"/>
                                        <MenuItem Header="Propriétés" Command="{Binding ShowPropertiesCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Copier le nom" Command="{Binding CopyNameCommand}"/>
                                        <MenuItem Header="Copier le chemin" Command="{Binding CopyPathCommand}"/>
                                        <MenuItem Header="Copier le PID" Command="{Binding CopyPidCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Terminer…" Style="{StaticResource DangerMenuItem}"
                                                  Command="{Binding TerminateCommand}"/>
                                        <MenuItem Header="{Binding Owner.TerminateSelectionHeader}" Style="{StaticResource DangerMenuItem}"
                                                  Command="{Binding Owner.TerminateSelectionCommand}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Détail de la ligne sélectionnée.

             ContentControl et non Border : poser DataContext ET une autre liaison sur le MÊME élément est
             un piège de WPF. Les autres liaisons de l'élément se résolvent alors contre le nouveau
             DataContext, donc « Visibility="{Binding SelectedRow}" » cherchait SelectedRow sur la ligne
             sélectionnée, où cette propriété n'existe pas — la carte ne se montrait ni ne se cachait
             correctement. Ici, Content ne change pas le DataContext du ContentControl : sa visibilité reste
             résolue contre le ViewModel de l'onglet, et le DataTemplate reçoit bien la ligne. -->
        <ContentControl Grid.Row="5" Content="{Binding SelectedRow}"
                        Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource H2}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run
                                        Text="{Binding MemberCountDisplay, Mode=OneWay}"
                                        Foreground="{StaticResource TextTertiaryBrush}"/>
                                </TextBlock>
                                <TextBox Text="{Binding PathDisplay}" Style="{StaticResource SelectableCaption}" Margin="0,4,0,0"
                                         TextWrapping="Wrap"/>
                                <!-- Un agrégat n'a ni PID ni parent : cette ligne ne le concerne pas. -->
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsAggregate, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Run Text="PID"/>
                                    <Run Text="{Binding Pid, Mode=OneWay}"/>
                                    <Run Text="· parent"/>
                                    <Run Text="{Binding ParentPid, Mode=OneWay}"/>
                                    <Run Text="· threads"/>
                                    <Run Text="{Binding ThreadsDisplay, Mode=OneWay}"/>
                                    <Run Text="· démarré le"/>
                                    <Run Text="{Binding StartTimeDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsAggregate, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding MemberCount, Mode=OneWay}"/>
                                    <Run Text="processus totalisés · threads"/>
                                    <Run Text="{Binding ThreadsDisplay, Mode=OneWay}"/>
                                    <Run Text="· le plus ancien démarré le"/>
                                    <Run Text="{Binding StartTimeDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBox Text="{Binding Publisher}" Style="{StaticResource SelectableCaption}" Margin="0,4,0,0"
                                         Visibility="{Binding Publisher, Converter={StaticResource NullToVisibility}}"/>
                                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding WindowTitle, Converter={StaticResource NullToVisibility}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Width="200" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="CPU"/><Run Text="{Binding CpuDisplay, Mode=OneWay}" FontWeight="SemiBold"
                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </TextBlock>
                                    <controls:Sparkline Series="{Binding CpuHistory}" Height="48" Margin="0,6,0,0"
                                                        Maximum="100" ValueFormatter="{Binding FormatCpu}"/>
                                </StackPanel>
                                <StackPanel Width="200">
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="Mémoire"/><Run Text="{Binding MemoryDisplay, Mode=OneWay}" FontWeight="SemiBold"
                                                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </TextBlock>
                                    <controls:Sparkline Series="{Binding MemoryHistory}" Height="48" Margin="0,6,0,0"
                                                        AutoScale="True" MinimumScale="52428800"
                                                        LineBrush="{StaticResource AccentBrush2}"
                                                        ValueFormatter="{Binding FormatMemory}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <TextBox Grid.Row="6" Text="{Binding StatusText}" Style="{StaticResource SelectableCaption}" Margin="0,10,0,0"
                 TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}"/>
    </Grid>
</UserControl>
