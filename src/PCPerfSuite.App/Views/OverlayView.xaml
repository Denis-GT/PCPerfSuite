<UserControl x:Class="PCPerfSuite.App.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <UserControl.Resources>
        <!-- Case de la grille de position de l'overlay : contenu centré, pilule carrée. -->
        <Style x:Key="AnchorButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="8" Margin="2" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne de réglage des couleurs : le nom, puis la palette de pastilles. -->
        <DataTemplate x:Key="ColorSlotTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Width="104" Margin="8,0,10,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <ItemsControl ItemsSource="{Binding Choices}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ColorSwatch}" Background="{Binding Brush}"
                                    Command="{Binding SelectCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Rendu d'une ligne d'overlay (aperçu) : un morceau coloré par segment. -->
        <DataTemplate x:Key="OverlayLineTemplate">
            <ItemsControl ItemsSource="{Binding Segments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="32,28,32,28">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Overlay en jeu" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,20" TextWrapping="Wrap"
                       Text="Affiche tes métriques par-dessus les jeux, par deux canaux cumulables : RTSS (RivaTuner Statistics Server, le moteur de MSI Afterburner — seul à fonctionner en plein écran exclusif) et/ou une fenêtre dessinée par PCPerfSuite (jeux fenêtrés et sans bordure, avec police, couleurs et position entièrement libres)."/>

            <!-- ============ Activation ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Activer l'overlay" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding UseRtss, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{Binding IsRtssDetected, Converter={StaticResource RtssStatus}}"/>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Canal RTSS" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Fonctionne partout, y compris en plein écran exclusif. RTSS doit être installé et lancé (gratuit, guru3d.com)." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseRtss}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Canal fenêtre PCPerfSuite" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Fenêtre transparente toujours au-dessus, traversante pour la souris. Aucune installation, mais invisible en plein écran exclusif." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseWindow}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rafraîchissement de l'overlay" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                    <Run Text="Indépendant de celui du Monitoring, sans pouvoir aller plus vite que lui (les valeurs viennent de là) —"/>
                                    <Run Text="{Binding RefreshHint, Mode=OneWay}"/>
                                    <Run Text="."/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource GlassTextBox}" Width="86" TextAlignment="Right"
                                         controls:TextBoxBehaviors.CommitOnEnter="True"
                                         Text="{Binding RefreshMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Une ligne par métrique" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Sinon, une ligne par catégorie façon Afterburner : « GPU  45%  62°C  180 W »." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OneLinePerMetric}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Métriques affichées" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <controls:MetricPicker DataContext="{Binding Metrics}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Apparence ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource H2}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Police" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource GlassComboBox}" DisplayMemberPath="Source"
                                  ItemsSource="{Binding Appearance.FontFamilies}" SelectedItem="{Binding Appearance.SelectedFont}"/>
                        <TextBlock Grid.Column="2" Text="Taille" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <Slider Grid.Column="3" Minimum="10" Maximum="48" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding Appearance.FontSize, Delay=150}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Appearance.FontSize, StringFormat={}{0:0} px}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Police et taille s'appliquent à la fenêtre PCPerfSuite et à l'aperçu ci-dessous. Dans RTSS, la police est celle configurée dans RTSS ; seule la taille lui est transmise (en %, réglage plus bas)."/>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Couleurs par catégorie" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Colore le nom en tête de ligne (CPU, RAM, NET…) pour repérer chaque valeur d'un coup d'œil." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.UseCategoryColors}" VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Appearance.CategoryColors}" ItemTemplate="{StaticResource ColorSlotTemplate}"
                                          Visibility="{Binding Appearance.UseCategoryColors, Converter={StaticResource BoolToVisibility}}"/>

                            <ContentControl Content="{Binding Appearance.ValueColor}" ContentTemplate="{StaticResource ColorSlotTemplate}"/>

                            <Button Content="Couleurs par défaut" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,4,0,0" Command="{Binding Appearance.ResetColorsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Réglages propres à RTSS -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"
                            Visibility="{Binding UseRtss, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Canal RTSS" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Envoyer les couleurs à RTSS" Style="{StaticResource Body}"/>
                                    <TextBlock Text="Utilise les balises de mise en forme de RTSS. À décocher si les balises s'affichent en clair en jeu (RTSS trop ancien, ou rendu vectoriel au lieu de raster)." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.SendColorsToRtss}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Taille du texte RTSS" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="50" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="10"
                                        Value="{Binding Appearance.RtssSizePercent, Delay=150}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Appearance.RtssSizePercent, StringFormat={}{0:0}%}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Réglages propres à la fenêtre -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"
                            Visibility="{Binding UseWindow, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Canal fenêtre" Style="{StaticResource Body}" FontWeight="SemiBold"/>

                            <TextBlock Text="Position sur l'écran principal" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                            <UniformGrid Rows="3" Columns="3" Width="150" HorizontalAlignment="Left">
                                <RadioButton Content="↖" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopLeft}"/>
                                <RadioButton Content="↑" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopCenter}"/>
                                <RadioButton Content="↗" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopRight}"/>
                                <RadioButton Content="←" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleLeft}"/>
                                <RadioButton Content="•" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleCenter}"/>
                                <RadioButton Content="→" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleRight}"/>
                                <RadioButton Content="↙" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomLeft}"/>
                                <RadioButton Content="↓" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomCenter}"/>
                                <RadioButton Content="↘" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                             IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomRight}"/>
                            </UniformGrid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Marge X" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="4"
                                        Value="{Binding Appearance.MarginX, Delay=150}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Appearance.MarginX, StringFormat={}{0:0} px}"/>
                                <TextBlock Grid.Column="3" Text="Marge Y" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                <Slider Grid.Column="4" Minimum="0" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="4"
                                        Value="{Binding Appearance.MarginY, Delay=150}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Appearance.MarginY, StringFormat={}{0:0} px}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fond" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Appearance.BackgroundOpacity, Delay=150}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Appearance.BackgroundOpacity, StringFormat={}{0:P0}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Aperçu ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Aperçu" Style="{StaticResource H2}"/>
                    <TextBlock Text="Exactement ce qui s'affiche en jeu (la fenêtre PCPerfSuite rend à l'identique ; RTSS applique en plus sa propre police)."
                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    <Border Background="#0B0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Margin="0,10,0,0"
                            TextElement.FontFamily="{Binding Appearance.SelectedFont}"
                            TextElement.FontSize="{Binding Appearance.FontSize}">
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource OverlayLineTemplate}"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
