<UserControl x:Class="PCPerfSuite.App.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <UserControl.Resources>
        <!-- Case de la grille de position de l'overlay : contenu centré, coins arrondis comme le reste. -->
        <Style x:Key="AnchorButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource HoverBrush}" CornerRadius="{StaticResource ControlRadius}" Margin="2" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TrackBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne de réglage des couleurs : une seule case (la couleur courante) et le nom. Un clic sur la
             case ouvre une petite fenêtre : couleurs de base, puis choix précis (carré, teinte, code hex).
             DataContext : OverlayColorSlotViewModel. -->
        <DataTemplate x:Key="ColorSlotTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Désactivée pendant que la fenêtre est ouverte : sinon un clic sur la case la ferme (StaysOpen=False,
                     clic hors de la fenêtre) puis la rouvre aussitôt (bascule du ToggleButton). -->
                <ToggleButton x:Name="Swatch" Style="{StaticResource ColorSlotButton}" Background="{Binding Brush}"
                              ToolTip="Changer la couleur"
                              IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InverseBoolean}}"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Width="120" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=Swatch, Mode=TwoWay}">
                    <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                        <StackPanel Width="200">
                            <TextBlock Text="Couleurs de base" Style="{StaticResource Eyebrow}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Choices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColorSwatch}" Background="{Binding Brush}"
                                                Command="{Binding SelectCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Couleur précise" Style="{StaticResource Eyebrow}" FontSize="11" Margin="0,12,0,8"/>
                            <controls:ColorPicker ColorHex="{Binding ColorHex, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">
            <controls:PageHeader Title="Overlay en jeu"
                                 Subtitle="Affiche tes métriques par-dessus les jeux, par deux canaux cumulables : RTSS (RivaTuner Statistics Server, le moteur de MSI Afterburner — seul à fonctionner en plein écran exclusif) et/ou une fenêtre dessinée par PCPerfSuite (jeux fenêtrés et sans bordure, avec police, couleurs et position entièrement libres)."/>

            <!-- ============ Activation ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Activer l'overlay" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding UseRtss, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{Binding IsRtssDetected, Converter={StaticResource RtssStatus}}"/>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Canal RTSS" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBox Text="Fonctionne partout, y compris en plein écran exclusif. RTSS doit être installé et lancé (gratuit) : Paramètres › Installations." Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseRtss}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Canal fenêtre PCPerfSuite" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBox Text="Fenêtre transparente toujours au-dessus, traversante pour la souris. Aucune installation, mais invisible en plein écran exclusif." Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseWindow}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rafraîchissement de l'overlay" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                    <Run Text="Indépendant de celui du Monitoring, sans pouvoir aller plus vite que lui (les valeurs viennent de là) —"/>
                                    <Run Text="{Binding RefreshHint, Mode=OneWay}"/>
                                    <Run Text="."/>
                                </TextBlock>
                                <TextBlock Text="{Binding CadenceText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource UnitTextBox}" Tag="ms"
                                         controls:NumericInput.IsNumeric="True"
                                         controls:NumericInput.Minimum="100" controls:NumericInput.Maximum="60000"
                                         ToolTip="{Binding RefreshHint}"
                                         Text="{Binding RefreshMs, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Une ligne par métrique" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Sinon, une ligne par catégorie façon Afterburner : « GPU  45%  62°C  180 W ». La mémoire du GPU a sa propre ligne VRAM, sous GPU ; les lignes VRAM et RAM disparaissent quand ce PC ne fournit aucune de leurs valeurs (pas de GPU dédié, par exemple). Sur la ligne JEU, chaque FPS est précédé de son libellé : « JEU  FPS 144  MOY 138  1% 95  0.1% 80  6.9 ms »." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OneLinePerMetric}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>
                        <TextBlock Text="Métriques affichées" Style="{StaticResource Eyebrow}" FontSize="12" Margin="0,0,0,10"/>
                        <controls:MetricPicker DataContext="{Binding Metrics}"/>

                        <!-- Ordre des lignes : celui du mode affiché (une ligne par catégorie ou par métrique).
                             Une entrée par ligne réellement affichée ; les autres gardent leur place en coulisse. -->
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ordre des lignes" Style="{StaticResource Eyebrow}" FontSize="12"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,12,0"
                                           Text="Monte ou descend une ligne avec les flèches ; l'aperçu, plus bas, montre le résultat. L'ordre est enregistré, séparément pour « une ligne par catégorie » et pour « une ligne par métrique »."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ordre par défaut" Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Top" Command="{Binding ResetLineOrderCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LineOrderItems}" Focusable="False" MaxWidth="520"
                                      HorizontalAlignment="Left" Margin="0,12,0,0"
                                      Visibility="{Binding HasLineOrderItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetTile}" Padding="12,4,6,4" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{Binding LabelBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30"
                                                        ToolTip="Monter cette ligne" Command="{Binding MoveUpCommand}"/>
                                                <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30"
                                                        Margin="4,0,0,0" ToolTip="Descendre cette ligne" Command="{Binding MoveDownCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucune ligne à ordonner : coche des métriques ci-dessus." Style="{StaticResource Caption}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasLineOrderItems, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Apparence ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource H2}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Police" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- ItemTemplate et non DisplayMemberPath : ce dernier ne s'applique qu'aux options
                             de la liste déroulée, pas à la case fermée (cf. LabelOptionTemplate). -->
                        <ComboBox Grid.Column="1" Style="{StaticResource GlassComboBox}"
                                  ItemsSource="{Binding Appearance.FontFamilies}" SelectedItem="{Binding Appearance.SelectedFont}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="Taille" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <controls:NumberField Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Minimum="10" Maximum="48" Value="{Binding Appearance.FontSize}" Unit="px"/>
                    </Grid>
                    <TextBox Style="{StaticResource SelectableCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Police et taille s'appliquent à la fenêtre PCPerfSuite et à l'aperçu ci-dessous. Dans RTSS, la police est celle configurée dans RTSS ; seule la taille lui est transmise (en %, réglage plus bas)."/>

                    <!-- Espacements : en nombre d'espaces, pour suivre la taille du texte dans la fenêtre comme dans RTSS.
                         Bornes : OverlaySpacing.MinSpaces et MaxSpaces. -->
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Espacements" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Entre les valeurs" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <controls:NumberField VerticalAlignment="Center" Minimum="1" Maximum="8"
                                                      Value="{Binding Appearance.ValueSpacing}" Unit="esp."/>
                                <TextBlock Text="Séparations" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="28,0,10,0"/>
                                <controls:NumberField VerticalAlignment="Center" Minimum="1" Maximum="8"
                                                      Value="{Binding Appearance.SeparatorSpacing}" Unit="esp."/>
                            </StackPanel>
                            <TextBox Style="{StaticResource SelectableCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                     Text="En nombre d'espaces, dans la fenêtre comme dans RTSS. « Entre les valeurs » écarte deux valeurs d'une même ligne (1 par défaut). « Séparations » s'applique après le nom de la ligne, avant chaque libellé de la ligne JEU (MOY, 1%…) et autour des débits disque et réseau, dont la largeur varie (2 par défaut)."/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Couleurs par catégorie" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBox Text="Colore le nom en tête de ligne (CPU, RAM, NET…) pour repérer chaque valeur d'un coup d'œil." Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.UseCategoryColors}" VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Appearance.CategoryColors}" ItemTemplate="{StaticResource ColorSlotTemplate}"
                                          Visibility="{Binding Appearance.UseCategoryColors, Converter={StaticResource BoolToVisibility}}"/>

                            <ContentControl Content="{Binding Appearance.ValueColor}" ContentTemplate="{StaticResource ColorSlotTemplate}"/>

                            <Button Content="Couleurs par défaut" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,4,0,0" Command="{Binding Appearance.ResetColorsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Réglages propres à RTSS -->
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"
                            Visibility="{Binding UseRtss, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Canal RTSS" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Envoyer les couleurs à RTSS" Style="{StaticResource Body}"/>
                                    <TextBox Text="Utilise les balises de mise en forme de RTSS. À décocher si les balises s'affichent en clair en jeu (RTSS trop ancien, ou rendu vectoriel au lieu de raster)." Style="{StaticResource SelectableCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appearance.SendColorsToRtss}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Taille du texte RTSS" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <controls:NumberField Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Minimum="50" Maximum="200" Value="{Binding Appearance.RtssSizePercent}" Unit="%"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Réglages propres à la fenêtre -->
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"
                            Visibility="{Binding UseWindow, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Canal fenêtre" Style="{StaticResource Body}" FontWeight="SemiBold"/>

                            <!-- Ancrage à gauche, curseurs à droite : la grille ne fait que 150 px et laissait
                                 tout le reste de la ligne vide, pendant que le curseur « Fond » juste en dessous
                                 s'étirait sur plus de mille pixels pour une plage de 0 à 1. -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Position sur l'écran principal" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <UniformGrid Rows="3" Columns="3" Width="150" HorizontalAlignment="Left">
                                        <RadioButton Content="↖" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopLeft}"/>
                                        <RadioButton Content="↑" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopCenter}"/>
                                        <RadioButton Content="↗" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=TopRight}"/>
                                        <RadioButton Content="←" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleLeft}"/>
                                        <RadioButton Content="•" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleCenter}"/>
                                        <RadioButton Content="→" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=MiddleRight}"/>
                                        <RadioButton Content="↙" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomLeft}"/>
                                        <RadioButton Content="↓" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomCenter}"/>
                                        <RadioButton Content="↘" Style="{StaticResource AnchorButton}" GroupName="overlay-anchor"
                                                     IsChecked="{Binding Appearance.Anchor, Converter={StaticResource EnumEquals}, ConverterParameter=BottomRight}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Les trois champs, un par ligne, centrés en face de la grille d'ancrage. -->
                                <Grid Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Marge X" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <controls:NumberField Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Minimum="0" Maximum="600" Value="{Binding Appearance.MarginX}" Unit="px"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Marge Y" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="0,10,10,0"/>
                                    <controls:NumberField Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,0"
                                                          Minimum="0" Maximum="600" Value="{Binding Appearance.MarginY}" Unit="px"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fond" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="0,10,10,0"/>
                                    <controls:NumberField Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,0"
                                                          Minimum="0" Maximum="100" Value="{Binding Appearance.BackgroundOpacityPercent}" Unit="%"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Aperçu ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Aperçu" Style="{StaticResource H2}"/>
                    <TextBox Text="Exactement ce qui s'affiche en jeu (la fenêtre PCPerfSuite rend à l'identique ; RTSS applique en plus sa propre police)."
                             Style="{StaticResource SelectableCaption}" Margin="0,4,0,0"/>
                    <Border Background="{StaticResource PreviewBackdropBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,12,0,0"
                            TextElement.FontFamily="{Binding Appearance.SelectedFont}"
                            TextElement.FontSize="{Binding Appearance.FontSize}"
                            controls:StickyWidth.IsScope="True"
                            controls:StickyWidth.ResetKey="{Binding LayoutVersion}">
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource OverlayLineTemplate}" Focusable="False"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
