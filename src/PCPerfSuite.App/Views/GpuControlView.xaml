<UserControl x:Class="PCPerfSuite.App.Views.GpuControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">
            <controls:PageHeader Title="GPU"
                                 Subtitle="Overclocking via NVAPI, comme les curseurs de MSI Afterburner : décalage d'horloge cœur/mémoire, limite de puissance, limite de température et surtension, avec profils enregistrés. Les plages autorisées sont celles annoncées par ton pilote, et chaque réglage refusé par la carte est signalé plutôt que silencieux. Le ventilateur du GPU se règle dans l'onglet « Ventilateurs », avec tous les autres."/>

            <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,16"
                    Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}"
                           Text="Aucun GPU NVIDIA piloté par NVAPI détecté (pas de GPU NVIDIA, pilote absent, ou app pas lancée en administrateur)."/>
            </Border>

            <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">

                <!-- ============ En-tête carte + relevés ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrandBrush}">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource H2}" FontSize="17" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource BadgeAccent}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BadgeText}">
                                    <Run Text="Bridé par :"/>
                                    <Run Text="{Binding ActiveLimitText, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <UniformGrid Rows="2" Columns="4" Margin="0,18,-10,-10">
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Charge" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding LoadPercent, Converter={StaticResource Metric}, ConverterParameter='%', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Température" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding CoreTempC, Converter={StaticResource Metric}, ConverterParameter=' °C', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Hot spot" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding HotSpotTempC, Converter={StaticResource Metric}, ConverterParameter=' °C', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Puissance" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding PowerWatts, Converter={StaticResource Metric}, ConverterParameter=' W', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Horloge cœur" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding CoreClockMhz, Converter={StaticResource Metric}, ConverterParameter=' MHz', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Horloge mémoire" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding MemoryClockMhz, Converter={StaticResource Metric}, ConverterParameter=' MHz', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="VRAM utilisée" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding VramUsedMb, Converter={StaticResource Metric}, ConverterParameter=' Mo', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InsetTile}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Ventilateur" Style="{StaticResource Caption}" FontSize="11.5"/>
                                    <TextBlock Style="{StaticResource StatValue}">
                                        <Run Text="{Binding FanRpm, Converter={StaticResource Metric}, ConverterParameter=' RPM', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============ Overclocking ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Overclocking" Style="{StaticResource H2}"/>
                        <TextBlock Text="Plages annoncées par le pilote. Chaque curseur s'applique quelques instants après avoir été relâché."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                        <!-- Limite de puissance -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Limite de puissance" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="{Binding PowerLimitMin}" Maximum="{Binding PowerLimitMax}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding PowerLimitPercent, Delay=250}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding PowerLimitPercent, StringFormat={}{0:0}%}"/>
                        </Grid>

                        <!-- Limite de température -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsTemperatureLimitSupported, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Limite de température" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="{Binding TemperatureLimitMin}" Maximum="{Binding TemperatureLimitMax}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TemperatureLimitC, Delay=250}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding TemperatureLimitC, StringFormat={}{0:0} °C}"/>
                        </Grid>

                        <!-- Décalages d'horloge -->
                        <StackPanel Visibility="{Binding IsClockOffsetSupported, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Horloge cœur" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="{Binding CoreOffsetMin}" Maximum="{Binding CoreOffsetMax}"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        Value="{Binding CoreOffsetMhz, Delay=400}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding CoreOffsetMhz, StringFormat='{}{0:+0;-0;0} MHz'}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Horloge mémoire" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="{Binding MemoryOffsetMin}" Maximum="{Binding MemoryOffsetMax}"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        Value="{Binding MemoryOffsetMhz, Delay=400}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding MemoryOffsetMhz, StringFormat='{}{0:+0;-0;0} MHz'}"/>
                            </Grid>

                            <TextBlock Text="{Binding AppliedOffsetsText}" Style="{StaticResource Caption}" Margin="170,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsClockOffsetSupported, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Ton pilote n'expose pas les décalages d'horloge (P-States 2.0) pour cette carte : la limite de puissance, la limite de température et la ventilation restent disponibles."/>

                        <!-- Surtension (Pascal uniquement) -->
                        <Grid Margin="0,12,0,0" Visibility="{Binding IsVoltageBoostSupported, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Surtension cœur" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Value="{Binding VoltageBoostPercent, Delay=400}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Body}" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding VoltageBoostPercent, StringFormat={}{0:0}%}"/>
                        </Grid>

                        <!-- Persistance -->
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Appliquer au démarrage" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Réapplique ces réglages au lancement de PCPerfSuite, et les laisse en place en quittant. Décoché, la carte repart toujours de ses réglages d'origine." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ApplyOverclockAtStartup}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Tout réinitialiser" Style="{StaticResource GhostButton}" Command="{Binding ResetOverclockCommand}"/>
                            <TextBlock Text="{Binding OverclockStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="Un décalage d'horloge trop élevé fige l'écran ou fait planter le pilote (sans rien casser : un redémarrage remet tout d'origine, et l'overclock n'est pas réappliqué si la case ci-dessus est décochée). Monte par paliers de 15 à 25 MHz et teste entre chaque."/>
                    </StackPanel>
                </Border>

                <!-- ============ Profils ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Profils" Style="{StaticResource H2}"/>
                        <TextBlock Text="Enregistre les réglages actuels sous un nom pour y revenir en un clic (un profil du même nom est remplacé)."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBox Style="{StaticResource GlassTextBox}" Width="220"
                                     controls:TextBoxBehaviors.CommitOnEnter="True"
                                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Enregistrer les réglages actuels" Style="{StaticResource AccentButton}"
                                    Margin="8,0,0,0" Command="{Binding SaveProfileCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Aucun profil enregistré pour l'instant." Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Visibility="{Binding Profiles.Count, Converter={StaticResource ZeroCountToVisibility}}"/>

                        <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetTile}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Appliquer" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Supprimer ce profil"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
