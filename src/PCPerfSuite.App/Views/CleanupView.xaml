<UserControl x:Class="PCPerfSuite.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">

            <controls:PageHeader Title="Nettoyage"
                                 Subtitle="Caches shaders, fichiers temporaires et autres dossiers qui s'accumulent sans qu'on y pense."/>

            <!-- App lancée sous un autre compte que la session : les caches listés ne sont pas ceux
                 de la personne devant l'écran, et il vaut mieux le dire que d'afficher "0 octet". -->
            <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,16"
                    Visibility="{Binding IsOtherProfile, Converter={StaticResource BoolToVisibility}}">
                <TextBox Style="{StaticResource SelectableBody}" Foreground="{StaticResource WarnBrush}"
                         Text="{Binding OtherProfileMessage, Mode=OneTime}" TextWrapping="Wrap"/>
            </Border>

            <!-- Synthèse -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="{StaticResource BrandBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Espace récupérable estimé" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding TotalReclaimableDisplay}" Style="{StaticResource MetricValue}" FontSize="32"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Ré-analyser" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                        Command="{Binding ScanAllCommand}"/>
                                <Button Content="Tout nettoyer" Style="{StaticResource AccentButton}"
                                        Command="{Binding CleanAllCommand}"/>
                            </StackPanel>
                            <!-- L'option qui change ce que fait « Tout nettoyer » se trouve juste dessous. Case carrée
                                 (style implicite), pas un interrupteur : c'est un choix qu'on coche, pas un réglage
                                 qu'on bascule. -->
                            <CheckBox Content="Vider aussi la corbeille" HorizontalAlignment="Right" Margin="0,10,0,0"
                                      IsChecked="{Binding IncludeRecycleBinInCleanAll}"
                                      ToolTip="Décochée, « Tout nettoyer » ne touche pas à la corbeille. Cochée, elle est vidée définitivement avec le reste."/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Corbeille : même gabarit de ligne que les caches, mais à part — ce n'est pas un cache qui se
                 régénère, et son contenu ne se récupère pas une fois vidé. Sa taille n'entre dans le total
                 que si « Tout nettoyer » la vide (case à cocher sous ce bouton, dans la carte de synthèse). -->
            <TextBlock Text="Corbeille" Style="{StaticResource Eyebrow}" FontSize="12" Margin="4,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="20,4" Margin="0,0,0,20" DataContext="{Binding RecycleBin}">
                <StackPanel>
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top"
                                Background="{StaticResource HoverBrush}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush2}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,20,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastResultMessage}" Margin="0,8,0,0"
                                       Visibility="{Binding LastResultMessage, Converter={StaticResource NullToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastResultFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Right"/>
                            <Button Content="Vider" Style="{StaticResource AccentButton}" Margin="0,8,0,0" HorizontalAlignment="Right"
                                    IsEnabled="{Binding CanEmpty}"
                                    Command="{Binding DataContext.EmptyRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Emplacements" Style="{StaticResource Eyebrow}" FontSize="12" Margin="4,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="20,4">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top"
                                            Background="{StaticResource HoverBrush}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush2}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource BadgeWarn}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Admin requis" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        <controls:MeterBar Value="{Binding SharePercent}" Height="4" Margin="0,10,0,0" MaxWidth="360"
                                                           HorizontalAlignment="Stretch"/>
                                        <TextBlock x:Name="Result" Text="{Binding LastResultMessage}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"
                                                   Visibility="{Binding LastResultMessage, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="&#xE838;" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                                    ToolTip="Ouvrir le dossier"
                                                    IsEnabled="{Binding Exists}"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Nettoyer" Style="{StaticResource AccentButton}"
                                                    IsEnabled="{Binding Exists}"
                                                    Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastResultFailed}" Value="True">
                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
