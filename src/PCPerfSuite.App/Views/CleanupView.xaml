<UserControl x:Class="PCPerfSuite.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,28,32,28">
        <StackPanel MaxWidth="1000">

            <TextBlock Text="Nettoyage" Style="{StaticResource H1}"/>
            <TextBlock Text="Caches shaders, fichiers temporaires et autres dossiers qui s'accumulent sans qu'on y pense."
                       Style="{StaticResource Caption}" Margin="0,4,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Espace récupérable estimé" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding TotalReclaimableDisplay}" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Vider la corbeille" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding EmptyRecycleBinCommand}"/>
                        <Button Content="Ré-analyser" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding ScanAllCommand}"/>
                        <Button Content="Tout nettoyer" Style="{StaticResource AccentButton}"
                                Command="{Binding CleanAllCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{StaticResource WarnBrush}"
                                               Text="Nécessite les droits administrateur"/>
                                    <TextBlock Text="{Binding LastResultMessage}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Visibility="{Binding LastResultMessage, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource H2}" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                                IsEnabled="{Binding Exists}"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Nettoyer" Style="{StaticResource AccentButton}"
                                                IsEnabled="{Binding Exists}"
                                                Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
