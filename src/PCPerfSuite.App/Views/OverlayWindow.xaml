<Window x:Class="PCPerfSuite.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCPerfSuite.App.Controls"
        Title="PCPerfSuite Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" IsHitTestVisible="False" Focusable="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- DataContext : OverlayViewModel. La police et la taille sont posées ici et héritées par tous
         les TextBlock des lignes. Le Border est la portée des colonnes fixes : elles repartent de zéro
         quand LayoutVersion change (métriques, mode, police). -->
    <Border x:Name="Root" CornerRadius="10" Padding="12,8"
            TextElement.FontFamily="{Binding Appearance.SelectedFont}"
            TextElement.FontSize="{Binding Appearance.FontSize}"
            controls:StickyWidth.IsScope="True"
            controls:StickyWidth.ResetKey="{Binding LayoutVersion}">
        <Border.Background>
            <SolidColorBrush Color="#000000" Opacity="{Binding Appearance.BackgroundOpacity}"/>
        </Border.Background>

        <!-- L'ombre portée garde le texte lisible sur une image claire. Posée sur le texte seul, pas sur le
             fond : l'effet est recalculé à chaque changement de ce qu'il couvre. -->
        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource OverlayLineTemplate}" Focusable="False">
            <ItemsControl.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
            </ItemsControl.Effect>
        </ItemsControl>
    </Border>
</Window>
