<UserControl x:Class="PCPerfSuite.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <UserControl.Resources>
        <!-- Réglages regroupés par catégorie : une carte par catégorie, une ligne par réglage. -->
        <CollectionViewSource x:Key="GroupedTweaks" Source="{Binding Tweaks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">

            <controls:PageHeader Title="Paramètres"
                                 Subtitle="Comportement de PCPerfSuite, puis réglages de performance Windows, y compris ceux masqués dans les menus standards (plan d'alimentation caché, planification GPU, etc.)."/>

            <TextBlock Text="PCPerfSuite" Style="{StaticResource Eyebrow}" FontSize="12" Margin="4,0,0,8"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Réduire dans la zone de notification à la fermeture"
                                   Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="La croix range l'app près de l'horloge au lieu de la quitter : le monitoring, les courbes de ventilation et l'overlay continuent de tourner. Clic sur l'icône pour rouvrir la fenêtre, clic droit → « Quitter » pour fermer vraiment l'app."/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding MinimizeToTrayOnClose}"/>
                </Grid>
            </Border>

            <!-- Ce que PCPerfSuite peut lire et piloter sur ce PC, et pourquoi le reste manque. -->
            <StackPanel DataContext="{Binding Compatibility}" Margin="0,0,0,20">
                <Grid Margin="4,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Compatibilité de ce PC" Style="{StaticResource Eyebrow}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Actualiser" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Copier le rapport" Style="{StaticResource AccentButton}" Command="{Binding CopyReportCommand}"
                            ToolTip="Copie ce diagnostic en texte, à joindre à un signalement de problème"/>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="20,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="StatusBadge" Grid.Column="1" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                            <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource BadgeWarn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                            <StackPanel>
                                <TextBlock Text="Métriques non disponibles sur ce PC (« N/D »)" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Ces valeurs ne sont pas fournies par le matériel ou les pilotes de ce PC : ce n'est pas un dysfonctionnement de PCPerfSuite."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                <TextBlock Text="Aucune : tout ce que propose PCPerfSuite est lu sur ce PC." Style="{StaticResource Caption}"
                                           Visibility="{Binding UnavailableMetrics.Count, Converter={StaticResource ZeroCountToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding UnavailableMetrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" ToolTip="{Binding Detail}">
                                                <Run Text="•"/>
                                                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Run Text="—"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CopyStatus}" Style="{StaticResource Caption}" Margin="0,0,0,12"
                                   Visibility="{Binding CopyStatus, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,20"
                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                               Text="Certains réglages ne s'appliqueront pas tant que l'app ne tourne pas en administrateur (clic droit → « Exécuter en tant qu'administrateur »)."/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTweaks}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel Margin="0,0,0,20">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" FontSize="12" Margin="4,0,0,8"/>
                                                <Border Style="{StaticResource Card}" Padding="20,4">
                                                    <ItemsPresenter/>
                                                </Border>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Redémarrage requis" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Border Style="{StaticResource BadgeWarn}"
                                                Visibility="{Binding IsRisky, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Compromis énergie/chaleur" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding IsUnknownState, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="État inconnu sur cette config" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Pas de séparateur au-dessus de la première ligne d'une carte. -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
