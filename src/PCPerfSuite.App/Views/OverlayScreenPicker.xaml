<UserControl x:Class="PCPerfSuite.App.Views.OverlayScreenPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext : OverlayScreenViewModel. Écran de l'overlay fenêtre ; l'ancrage et les marges, en dessous,
         valent pour tous les écrans. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Écran" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" MinWidth="170" VerticalAlignment="Center" Style="{StaticResource GlassComboBox}"
                      ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Description}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" MinWidth="240" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource GlassComboBox}"
                      ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                      Visibility="{Binding IsFixedMode, Converter={StaticResource BoolToVisibility}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="3" Content="Identifier" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding IdentifyCommand}"
                    ToolTip="Affiche quelques secondes le numéro de chaque écran, celui de la liste."/>
        </Grid>

        <TextBox Text="{Binding SelectedMode.Description, Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,6,0,0"/>

        <!-- Écran choisi débranché, écrans identiques, liste illisible : le message dit où est l'overlay et pourquoi. -->
        <Border Style="{StaticResource CalloutWarn}" Margin="0,10,0,0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBox Style="{StaticResource SelectableBody}" Foreground="{StaticResource WarnBrush}"
                     Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
