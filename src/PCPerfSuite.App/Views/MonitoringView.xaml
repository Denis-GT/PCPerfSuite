<UserControl x:Class="PCPerfSuite.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">

            <controls:PageHeader Title="Monitoring" Margin="0,0,0,16"
                                 Subtitle="Vue d'ensemble des capteurs — clique une courbe pour lire la valeur exacte d'un relevé."/>

            <!-- Barre d'outils : cadence globale et panneaux de personnalisation. -->
            <Border Style="{StaticResource InsetTile}" Padding="14,8" Margin="0,0,0,18">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                        <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Actualisation" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Style="{StaticResource UnitTextBox}" Tag="ms"
                                 controls:TextBoxBehaviors.CommitOnEnter="True"
                                 ToolTip="{Binding RefreshHint}"
                                 Text="{Binding RefreshMs, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCustomizingCadences}" VerticalAlignment="Center"
                                  ToolTip="Cadence de relecture de chaque groupe de capteurs"/>
                        <TextBlock Text="Cadence par capteur" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCustomizingMyMetrics}" VerticalAlignment="Center"
                                  ToolTip="Choisir les capteurs affichés en graphique"/>
                        <TextBlock Text="Choisir les graphiques" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- Remet à zéro les min, moyennes et max de toutes les tuiles d'un seul geste (avant un benchmark,
                         par exemple). Les courbes ne sont pas effacées. -->
                    <Button Content="Réinitialiser les statistiques" Style="{StaticResource GhostButton}" Margin="0,2,0,2"
                            Command="{Binding ResetMetricStatsCommand}"
                            ToolTip="Les min, moyennes et max de toutes les tuiles repartent de zéro. Les courbes sont conservées."/>
                </WrapPanel>
            </Border>

            <!-- Cadence par groupe de capteurs, juste sous l'actualisation globale qu'elle affine. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsCustomizingCadences, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Cadence des capteurs" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding SensorCadencesHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Groupe" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="1" Text="Auto" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="2" Text="Relecture" Style="{StaticResource ColumnHeader}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SensorCadences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="380"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsAuto}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  ToolTip="Auto : l'app espace elle-même la lecture de ce groupe si elle coûte cher"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Auto : ce que l'app a décidé. Sinon : l'intervalle choisi. -->
                                            <TextBox Text="{Binding StatusText}" Style="{StaticResource SelectableBody}" FontSize="12.5"
                                                     Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="Relu toutes les" Style="{StaticResource Body}" FontSize="12.5"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Style="{StaticResource UnitTextBox}" Tag="ms"
                                                         controls:TextBoxBehaviors.CommitOnEnter="True"
                                                         ToolTip="{Binding RefreshHint}"
                                                         Text="{Binding ManualMs, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding ReasonText}" Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Choix des capteurs affichés : catalogue partagé avec l'overlay et capteurs propres à la machine. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsCustomizingMyMetrics, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Capteurs affichés" Style="{StaticResource H2}"/>
                    <TextBox Text="Les ventilateurs, disques, sondes et tensions de la carte mère apparaissent dès le premier relevé."
                             Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <controls:MetricPicker DataContext="{Binding MyMetrics}"/>
                </StackPanel>
            </Border>

            <!-- Tuiles graphiques : une par capteur choisi. -->
            <ItemsControl ItemsSource="{Binding MyMetricTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGrid MinItemWidth="270" Spacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Pas d'infobulle sur la tuile entière : elle s'afficherait aussi au survol du graphique
                             (l'infobulle d'un parent se déclenche depuis n'importe quel enfant) et recouvrirait le
                             repère de valeur. Elle est posée sur le seul élément qui en a besoin, le libellé tronqué. -->
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <!-- Deux colonnes seulement, et l'intitulé sous le nom de catégorie. Avec les trois
                                     colonnes d'avant (intitulé en « * », min/moy/max et valeur en « Auto »), WPF
                                     servait les deux « Auto » en premier et il ne restait parfois rien à l'intitulé :
                                     tronqué à zéro pixel, il ne dessinait même pas ses points de suspension. C'est ce
                                     qui faisait disparaître le libellé des tuiles à valeur large — débits disque et
                                     réseau, mAh de la batterie. MinWidth garantit qu'il reste toujours de la place. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="96"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding LineBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Eyebrow}" Foreground="{Binding LineBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>

                                    <!-- Chiffres de largeur égale, et une place qui ne rétrécit pas : la valeur ne se
                                         tortille plus d'un relevé à l'autre. -->
                                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" TextWrapping="NoWrap" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                               controls:StickyWidth.IsEnabled="True" controls:StickyWidth.ResetKey="{Binding StatsEpoch}"
                                               ToolTip="{Binding Note}">
                                        <Run Text="{Binding DisplayValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Min, moyenne et max depuis le démarrage (ou la dernière remise à zéro), sur leur
                                     propre ligne et alignés à droite, sous la valeur en direct. Ils partageaient avant
                                     la ligne de l'intitulé et lui prenaient toute la place. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                            Typography.NumeralAlignment="Tabular"
                                            ToolTip="Min, moyenne et max depuis le démarrage ou la dernière remise à zéro">
                                    <!-- Une colonne qui ne rétrécit jamais par mini-colonne (et pas seulement sur le bloc
                                         entier) : ni les trois chiffres entre eux, ni la valeur en direct à leur droite
                                         ne se décalent d'un relevé à l'autre. -->
                                    <StackPanel Margin="0,0,10,0" controls:StickyWidth.IsEnabled="True"
                                                controls:StickyWidth.ResetKey="{Binding StatsEpoch}">
                                        <TextBlock Text="min" Style="{StaticResource ColumnHeader}" FontSize="9" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding MinimumDisplay, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" controls:StickyWidth.IsEnabled="True"
                                                controls:StickyWidth.ResetKey="{Binding StatsEpoch}">
                                        <TextBlock Text="moy" Style="{StaticResource ColumnHeader}" FontSize="9" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding AverageDisplay, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel controls:StickyWidth.IsEnabled="True"
                                                controls:StickyWidth.ResetKey="{Binding StatsEpoch}">
                                        <TextBlock Text="max" Style="{StaticResource ColumnHeader}" FontSize="9" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding MaximumDisplay, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Pourquoi la valeur n'est pas un nombre (conso totale "secteur" sur un portable branché). -->
                                <TextBox Text="{Binding Note}" Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                         Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"/>
                                <!-- Clic gauche : épingle la valeur exacte du relevé visé (glisser pour la déplacer,
                                     clic droit ou Échap pour l'enlever). -->
                                <controls:Sparkline x:Name="Graph" Series="{Binding History}" Height="64" Margin="0,10,0,0"
                                                    LineBrush="{Binding LineBrush}" FillBrush="{Binding FillBrush}"
                                                    AutoScale="{Binding AutoScale}" Maximum="{Binding GraphMaximum}"
                                                    MinimumScale="{Binding MinimumScale}" CenterZero="{Binding CenterZero}"
                                                    ValueFormatter="{Binding FormatSample}"/>
                                <!-- "N/D" : à la place d'une courbe vide, pourquoi ce PC ne fournit pas la valeur. -->
                                <TextBlock x:Name="UnavailableHint" Text="{Binding UnavailableHint}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Height="64" Margin="0,10,0,0" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding UnavailableHint}"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                <Setter TargetName="Graph" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="UnavailableHint" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Aucun capteur affiché — active « Choisir les graphiques » pour en choisir." Style="{StaticResource Caption}"
                       Visibility="{Binding MyMetricTiles.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,0,0,16"/>

            <!-- Batterie : ce qui n'évolue qu'au fil des mois (santé, capacités, cycles), donc sans courbe. Charge,
                 décharge et capacité restante sont des tuiles comme les autres. Masquée sans batterie (PC fixe). -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" DataContext="{Binding Battery}"
                    Visibility="{Binding IsPresent, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Batterie" Style="{StaticResource H2}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0"/>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="État de santé" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text="{Binding Name, Mode=OneWay, StringFormat={}  ·  {0}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <controls:MeterBar Grid.Column="1" Value="{Binding HealthPercent}" VerticalAlignment="Center" Margin="8,0"
                                           ToolTip="État de santé : capacité à pleine charge rapportée à la capacité nominale"/>
                        <TextBlock Grid.Column="2" Text="{Binding HealthDisplay}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Capacité nominale" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesignCapacityDisplay}" Style="{StaticResource Body}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="Capacité à pleine charge" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullChargeCapacityDisplay}" Style="{StaticResource Body}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Text="Cycles de charge" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CycleCountDisplay}" Style="{StaticResource Body}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Text="Alimentation" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateDisplay}" Style="{StaticResource Body}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Text="Fabricant · chimie" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailsDisplay}" Style="{StaticResource Body}" Margin="0,2"/>
                    </Grid>
                    <TextBox Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                             Text="Valeurs du pilote de batterie Windows, en mWh. Les mAh en sont déduits à la tension actuelle de la batterie."
                             Visibility="{Binding HasNote, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <!-- Pilote en unités relatives : santé, capacités, watts et mA ne sont pas mesurables, on dit pourquoi. -->
                    <TextBox Text="{Binding Note}" Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Mémoire : ce que montre la page "Mémoire" du Gestionnaire des tâches et qui ne bouge pas —
                 type, fréquence, emplacements, barrettes. Charge et utilisation sont des tuiles comme les
                 autres. Ces données viennent de la table SMBIOS du BIOS : beaucoup de mini-PC et de
                 portables à mémoire soudée ne la remplissent pas, et la carte le dit alors au lieu de
                 rester vide. -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" DataContext="{Binding MemoryInfo}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mémoire" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding TotalDisplay, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text="{Binding SummaryDisplay, Mode=OneWay, StringFormat={}  ·  {0}}"/>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Emplacements occupés" Style="{StaticResource Caption}" Margin="0,2,16,2"/>
                        <TextBlock Grid.Column="1" Text="{Binding SlotsDisplay}" Style="{StaticResource Body}" Margin="0,2"
                                   ToolTip="Barrettes présentes rapportée au nombre d'emplacements de la carte, quand le BIOS le publie."/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEEA0;" Style="{StaticResource Icon}" FontSize="15"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Slot}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CapacityDisplay}" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DetailsDisplay}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DetailsDisplay}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TemperatureDisplay}" Style="{StaticResource Caption}"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip="Sonde thermique de la barrette, quand elle en porte une de lisible."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pas de fiche matérielle : on dit pourquoi, et que les mesures, elles, sont bonnes. -->
                    <TextBox Text="{Binding Note}" Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                             Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Disques : occupation, usure et test de santé. Débits et température sont des tuiles comme les autres. -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,16">
                <StackPanel>
                    <TextBlock Text="Disques" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Disks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <!-- Espace utilisé, pas un indicateur de santé : jamais coloré en orange/rouge (voir doc de UseValueColor sur MeterBar). -->
                                            <TextBlock Grid.Column="1" Text="Espace utilisé" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <controls:MeterBar Grid.Column="2" Value="{Binding UsedPercent}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource Caption}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center">
                                                <Run Text="Vie restante :"/>
                                                <Run Text="{Binding RemainingLifeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Santé (Windows Storage Management), visuellement distincte de l'occupation ci-dessus. -->
                                        <Grid Margin="0,10,0,0" Background="{StaticResource SurfaceAltBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding HealthSummary}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,6,10,6"
                                                       Foreground="{Binding HealthStatus, Converter={StaticResource DiskHealthBrush}}"/>
                                            <Button Grid.Column="1" Content="{Binding TestButtonLabel}" Style="{StaticResource GhostButton}"
                                                    Command="{Binding TestCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolean}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun disque détecté — vérifie que l'app tourne en administrateur." Style="{StaticResource Caption}"
                               Visibility="{Binding Disks.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Temps de lecture des capteurs : coût de chaque lecture, matériel par matériel. -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temps de lecture des capteurs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Ticks sautés :"/>
                                <Run Text="{Binding SkippedTicks, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="Réinitialiser" Style="{StaticResource GhostButton}" Command="{Binding ResetReadTimingsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ReadTimingsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lecture" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="1" Text="Dernière" Style="{StaticResource ColumnHeader}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Moyenne" Style="{StaticResource ColumnHeader}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource ColumnHeader}" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReadTimings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AverageDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MaxDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CalloutDanger}" Margin="0,0,0,20"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Body}" Foreground="{StaticResource DangerBrush}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
