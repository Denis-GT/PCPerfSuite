<UserControl x:Class="PCPerfSuite.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <ScrollViewer Padding="32,28,32,28">
        <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">

            <TextBlock Text="Monitoring" Style="{StaticResource H1}"/>
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Vue d'ensemble des composants." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Actualisation :" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
                        <ListBox ItemsSource="{Binding RefreshRateOptions}" SelectedItem="{Binding SelectedRefreshRate}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,5" Margin="1,0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>

            <WrapPanel>
                <!-- CPU -->
                <Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="PROCESSEUR" Style="{StaticResource Caption}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CpuLoad, StringFormat={}{0:0}%}" Style="{StaticResource MetricValue}"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Right">
                                    <Run Text="{Binding CpuTemp, Converter={StaticResource Metric}, ConverterParameter=°C, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right">
                                    <Run Text="{Binding CpuPower, Converter={StaticResource Metric}, ConverterParameter=W, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <controls:MeterBar Value="{Binding CpuLoad}" Margin="0,12,0,0"/>
                        <controls:Sparkline x:Name="CpuSparkline" Height="52" Margin="0,14,0,0"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                            <Run Text="Fréquence max :"/>
                            <Run Text="{Binding CpuClock, Converter={StaticResource Metric}, ConverterParameter= MHz, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16"
                        Visibility="{Binding HasGpu, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GpuVendor}" Style="{StaticResource Caption}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding GpuLoad, StringFormat={}{0:0}%}" Style="{StaticResource MetricValue}"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Right">
                                    <Run Text="{Binding GpuTemp, Converter={StaticResource Metric}, ConverterParameter=°C, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right">
                                    <Run Text="{Binding GpuPower, Converter={StaticResource Metric}, ConverterParameter=W, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <controls:MeterBar Value="{Binding GpuLoad}" Margin="0,12,0,0" IndicatorBrush="{StaticResource AccentBrush2}"/>
                        <controls:Sparkline x:Name="GpuSparkline" Height="52" Margin="0,14,0,0" LineBrush="{StaticResource AccentBrush2}"
                                            FillBrush="#305FE0C7"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Caption}">
                                <Run Text="Cœur :"/>
                                <Run Text="{Binding GpuCoreClock, Converter={StaticResource Metric}, ConverterParameter= MHz, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                <Run Text="Mém. :"/>
                                <Run Text="{Binding GpuMemClock, Converter={StaticResource Metric}, ConverterParameter= MHz, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <controls:MeterBar Value="{Binding GpuVramLoad}" Margin="0,10,0,0" Height="6" IndicatorBrush="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}">
                            <Run Text="VRAM :"/>
                            <Run Text="{Binding GpuVramUsed, Converter={StaticResource Metric}, ConverterParameter= Mo, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding GpuVramTotal, Converter={StaticResource Metric}, ConverterParameter= Mo, Mode=OneWay}"/>
                            <Run Text=" · Ventilo :"/>
                            <Run Text="{Binding GpuFanRpm, Converter={StaticResource Metric}, ConverterParameter= RPM, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Mémoire vive" Style="{StaticResource H2}"/>
                        <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding MemLoad, StringFormat={}{0:0}%}" Style="{StaticResource MetricValue}" Margin="0,14,0,0"/>
                        <controls:MeterBar Value="{Binding MemLoad}" Margin="0,12,0,0" IndicatorBrush="{StaticResource WarnBrush}"/>
                        <controls:Sparkline x:Name="MemSparkline" Height="52" Margin="0,14,0,0" LineBrush="{StaticResource WarnBrush}" FillBrush="#30FF9F0A"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                            <Run Text="{Binding MemUsedGb, Converter={StaticResource Metric}, ConverterParameter= Go, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding MemTotalGb, Converter={StaticResource Metric}, ConverterParameter= Go, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Carte mère -->
                <Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="{Binding MotherboardName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="CARTE MÈRE" Style="{StaticResource Caption}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource MetricValue}">
                                    <Run Text="{Binding MotherboardTemp, Converter={StaticResource Metric}, ConverterParameter=°C, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Température système" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Right">
                                    <Run Text="{Binding MotherboardVrmTemp, Converter={StaticResource Metric}, ConverterParameter=°C, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="VRM" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Autres zones de température/tensions : la liste dépend entièrement de ce que le
                             Super I/O de cette carte mère expose, elle peut donc être vide sur certaines configs. -->
                        <ItemsControl ItemsSource="{Binding MotherboardOtherTemps}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                            <Run Text="{Binding Value, Converter={StaticResource Metric}, ConverterParameter=°C, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MotherboardVoltages}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                            <Run Text="{Binding Value, Converter={StaticResource Metric}, ConverterParameter=V, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Disques -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Disques" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Disks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <controls:MeterBar Grid.Column="1" Value="{Binding UsedPercent}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource Caption}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Lecture" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding ReadRateDisplay}" Style="{StaticResource Body}" FontSize="12.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Écriture" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding WriteRateDisplay}" Style="{StaticResource Body}" FontSize="12.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Température" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding TemperatureDisplay}" Style="{StaticResource Body}" FontSize="12.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Vie restante" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding RemainingLifeDisplay}" Style="{StaticResource Body}" FontSize="12.5"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding HealthSummary}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                                                       Foreground="{Binding HealthStatus, Converter={StaticResource DiskHealthBrush}}"/>
                                            <Button Grid.Column="1" Content="{Binding TestButtonLabel}" Style="{StaticResource GhostButton}"
                                                    Command="{Binding TestCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolean}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun disque détecté — vérifie que l'app tourne en administrateur." Style="{StaticResource Caption}"
                               Visibility="{Binding Disks.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ventilateurs -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Ventilateurs détectés" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Fans}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Body}" VerticalAlignment="Center">
                                        <Run Text="{Binding SensorName, Mode=OneWay}"/>
                                        <Run Text=" — " Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text="{Binding HardwareName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
                                    </TextBlock>
                                    <controls:MeterBar Grid.Column="1" Value="{Binding PercentControl, Mode=OneWay, Converter={StaticResource NullableToDouble}}" VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding Rpm, Converter={StaticResource Metric}, ConverterParameter= RPM, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun ventilateur détecté — vérifie que l'app tourne en administrateur." Style="{StaticResource Caption}"
                               Visibility="{Binding Fans.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
