<UserControl x:Class="PCPerfSuite.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <ScrollViewer Padding="32,28,32,28">
        <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">

            <TextBlock Text="Monitoring" Style="{StaticResource H1}"/>
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Vue d'ensemble des capteurs." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Actualisation :" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource GlassTextBox}" Width="86" TextAlignment="Right"
                             controls:TextBoxBehaviors.CommitOnEnter="True"
                             ToolTip="{Binding RefreshHint}"
                             Text="{Binding RefreshMs, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Cadence par capteur" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCustomizingCadences}" VerticalAlignment="Center"
                              ToolTip="Cadence de relecture de chaque groupe de capteurs"/>
                    <TextBlock Text="Personnaliser" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCustomizingMyMetrics}" VerticalAlignment="Center"
                              ToolTip="Choisir les capteurs affichés en graphique"/>
                </StackPanel>
            </Grid>

            <!-- Cadence par groupe de capteurs, juste sous l'actualisation globale qu'elle affine. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsCustomizingCadences, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Cadence des capteurs" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding SensorCadencesHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Groupe" Style="{StaticResource Caption}" FontSize="10.5"/>
                        <TextBlock Grid.Column="1" Text="Auto" Style="{StaticResource Caption}" FontSize="10.5"/>
                        <TextBlock Grid.Column="2" Text="Relecture" Style="{StaticResource Caption}" FontSize="10.5"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SensorCadences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="380"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsAuto}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  ToolTip="Auto : l'app espace elle-même la lecture de ce groupe si elle coûte cher"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Auto : ce que l'app a décidé. Sinon : l'intervalle choisi. -->
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" FontSize="12.5"
                                                       Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="Relu toutes les" Style="{StaticResource Body}" FontSize="12.5"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Style="{StaticResource GlassTextBox}" Width="86" TextAlignment="Right"
                                                         controls:TextBoxBehaviors.CommitOnEnter="True"
                                                         Text="{Binding ManualMs, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReasonText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Choix des capteurs affichés : catalogue partagé avec l'overlay et capteurs propres à la machine. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsCustomizingMyMetrics, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Capteurs affichés" Style="{StaticResource H2}"/>
                    <TextBlock Text="Les ventilateurs, disques, sondes et tensions de la carte mère apparaissent dès le premier relevé."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <controls:MetricPicker DataContext="{Binding MyMetrics}"/>
                </StackPanel>
            </Border>

            <!-- Tuiles graphiques : une par capteur choisi. -->
            <ItemsControl ItemsSource="{Binding MyMetricTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="0,0,14,14" Padding="16,12" CornerRadius="14" ToolTip="{Binding Label}"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CategoryName, Mode=OneWay}" Foreground="{Binding LineBrush, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" TextWrapping="NoWrap" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Run Text="{Binding DisplayValue, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </Grid>
                                <controls:Sparkline Series="{Binding History}" Height="64" Margin="0,10,0,0"
                                                    LineBrush="{Binding LineBrush}" FillBrush="{Binding FillBrush}"
                                                    AutoScale="{Binding AutoScale}" Maximum="{Binding GraphMaximum}"
                                                    MinimumScale="{Binding MinimumScale}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Aucun capteur affiché — active « Personnaliser » pour en choisir." Style="{StaticResource Caption}"
                       Visibility="{Binding MyMetricTiles.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,0,0,16"/>

            <!-- Disques : occupation, usure et test de santé. Débits et température sont des tuiles comme les autres. -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Disques" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Disks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <controls:MeterBar Grid.Column="1" Value="{Binding UsedPercent}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource Caption}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center">
                                                <Run Text="Vie restante :"/>
                                                <Run Text="{Binding RemainingLifeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding HealthSummary}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                                                       Foreground="{Binding HealthStatus, Converter={StaticResource DiskHealthBrush}}"/>
                                            <Button Grid.Column="1" Content="{Binding TestButtonLabel}" Style="{StaticResource GhostButton}"
                                                    Command="{Binding TestCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolean}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun disque détecté — vérifie que l'app tourne en administrateur." Style="{StaticResource Caption}"
                               Visibility="{Binding Disks.Count, Converter={StaticResource ZeroCountToVisibility}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Temps de lecture des capteurs : coût de chaque lecture, matériel par matériel. -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temps de lecture des capteurs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Ticks sautés :"/>
                                <Run Text="{Binding SkippedTicks, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="Réinitialiser" Style="{StaticResource GhostButton}" Command="{Binding ResetReadTimingsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ReadTimingsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lecture" Style="{StaticResource Caption}" FontSize="10.5"/>
                        <TextBlock Grid.Column="1" Text="Dernière" Style="{StaticResource Caption}" FontSize="10.5" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Moyenne" Style="{StaticResource Caption}" FontSize="10.5" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource Caption}" FontSize="10.5" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReadTimings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AverageDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MaxDisplay}" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
