<UserControl x:Class="PCPerfSuite.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Stockage"
                             Subtitle="Cartographie de l'occupation disque façon SpaceSniffer — clique un bloc pour le dévoiler, reclique pour le replier, clic droit pour plus d'actions."/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Disques à analyser" Style="{StaticResource H2}"/>
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource SelectableTile}" IsChecked="{Binding IsSelected}" Width="264" Margin="0,0,10,10"
                                      AutomationProperties.Name="{Binding Title}">
                                <StackPanel>
                                    <!-- Marge droite : laisse libre le coin de la pastille de sélection de la tuile. -->
                                    <Grid Margin="0,0,28,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IconPlate" Width="38" Height="38" CornerRadius="10" Background="{StaticResource HoverBrush}">
                                            <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="20"
                                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource BadgeAccent}" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Système" Style="{StaticResource BadgeText}" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <controls:MeterBar x:Name="Meter" Value="{Binding UsedPercent}" Height="6" Margin="0,14,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Caption}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource Caption}"
                                                   FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </CheckBox>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="IconPlate" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                    <Setter TargetName="Meter" Property="IndicatorBrush" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Annuler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Analyser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,0,10"
                    Visibility="{Binding RootNode, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding RootNode.Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="3" MinHeight="260"
                Visibility="{Binding RootNode, Converter={StaticResource NullToVisibility}}">
            <controls:TreemapControl Nodes="{Binding RootNode.Children}"
                                      HoveredNode="{Binding HoveredNode, Mode=TwoWay}"
                                      SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                      TreeVersion="{Binding TreeVersion}">
                <controls:TreemapControl.ContextMenu>
                    <!-- Le menu vit dans son propre popup, hors de l'arbre visuel de la vue : on le relie
                         explicitement à la treemap (PlacementTarget, fixé par le contrôle à l'ouverture).
                         Ses entrées lisent ContextNode, le bloc visé, et remontent au ViewModel par DataContext. -->
                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Ouvrir"
                                  Command="{Binding DataContext.OpenCommand}" CommandParameter="{Binding ContextNode}"/>
                        <MenuItem Header="Ouvrir dans l'Explorateur"
                                  Command="{Binding DataContext.OpenInExplorerCommand}" CommandParameter="{Binding ContextNode}"/>
                        <MenuItem Header="Copier le chemin"
                                  Command="{Binding DataContext.CopyPathCommand}" CommandParameter="{Binding ContextNode}"/>
                        <MenuItem Command="{Binding ToggleExpandCommand}" CommandParameter="{Binding ContextNode}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="Déplier"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContextNodeExpanded}" Value="True">
                                            <Setter Property="Header" Value="Replier"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="Rescanner ce dossier"
                                  Command="{Binding DataContext.RescanCommand}" CommandParameter="{Binding ContextNode}"/>
                        <MenuItem Header="Propriétés"
                                  Command="{Binding DataContext.ShowPropertiesCommand}" CommandParameter="{Binding ContextNode}"/>
                        <Separator/>
                        <MenuItem Header="Supprimer (Corbeille)…" Style="{StaticResource DangerMenuItem}"
                                  Command="{Binding DataContext.DeleteCommand}" CommandParameter="{Binding ContextNode}"/>
                    </ContextMenu>
                </controls:TreemapControl.ContextMenu>
            </controls:TreemapControl>
        </Border>

        <Border Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HoveredNode, Converter={StaticResource NullToVisibility}}">
            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding HoveredNode.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Run Text=" — "/>
                <Run Text="{Binding HoveredNode.FullPath, Mode=OneWay}"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
