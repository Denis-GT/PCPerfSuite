<UserControl x:Class="PCPerfSuite.App.Views.BenchDiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <UserControl.Resources>
        <!-- Sous-onglet pas encore livré (#12, #13) : son texte, dans la page, sans second défilement. -->
        <DataTemplate x:Key="ComingSoonBlock">
            <StackPanel>
                <Border Style="{StaticResource BadgeAccent}" HorizontalAlignment="Left">
                    <TextBlock Text="Bientôt disponible" Style="{StaticResource BadgeText}"/>
                </Border>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,16" TextWrapping="Wrap"/>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Bullets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="2,7,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}">
            <controls:PageHeader Title="Bench et diagnostic"
                                 Subtitle="Mesurer les performances de ce PC, test par test, avec des chiffres comparables et sans risque : processeur, mémoire et disque aujourd'hui ; carte graphique, alimentation et diagnostic à venir."/>

            <!-- Sous-onglets : Bench (#10), Diagnostic (#12), Technicien (#13). -->
            <ListBox Style="{StaticResource PillSelector}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     DisplayMemberPath="Title" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <!-- ==================== Bench ==================== -->
            <StackPanel DataContext="{Binding Bench}"
                        Visibility="{Binding DataContext.SelectedSection.Key, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=bench}">

                <!-- Durées, seuils et références pas encore vérifiés sur une vraie machine (règle 6). -->
                <Border Style="{StaticResource BadgeWarn}" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="Expérimental" Style="{StaticResource BadgeText}"/>
                </Border>

                <!-- Toute la fonction indisponible sur ce PC : la raison, adaptée à la machine (règle 3). -->
                <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,16"
                        Visibility="{Binding UnavailableMessage, Converter={StaticResource NullToVisibility}}">
                    <TextBox Style="{StaticResource SelectableBody}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{Binding UnavailableMessage, Mode=OneWay}"/>
                </Border>

                <!-- Un bench interrompu au dernier arrêt (reprise au lancement). -->
                <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,16"
                        Visibility="{Binding RecoveryNote, Converter={StaticResource NullToVisibility}}">
                    <TextBox Style="{StaticResource SelectableBody}" TextWrapping="Wrap" Text="{Binding RecoveryNote, Mode=OneWay}"/>
                </Border>

                <!-- Bail de réglage tenu par un autre : le bench sera refusé avec la raison. -->
                <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,16"
                        Visibility="{Binding Tuning.LeaseText, Converter={StaticResource NullToVisibility}}">
                    <TextBox Style="{StaticResource SelectableBody}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{Binding Tuning.LeaseText, Mode=OneWay}"/>
                </Border>

                <!-- ============ Tests ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Tests" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="Chaque test se coche indépendamment. Un test indisponible sur ce PC dit pourquoi. Le processeur passe une mesure « rafale » dès les premières secondes et, si la phase soutenue est cochée, une seconde après 3 minutes de charge : l'écart est déjà un diagnostic."/>

                        <ItemsControl ItemsSource="{Binding Tests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"/>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding Reason, Converter={StaticResource NullToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding EstimateText}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Options du test disque : volume au choix (tout volume local), taille par +/−. -->
                        <Border Style="{StaticResource InsetTile}" Margin="0,4,0,12">
                            <StackPanel>
                                <TextBlock Text="Test disque" Style="{StaticResource Body}"/>
                                <ComboBox Style="{StaticResource GlassComboBox}" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}"
                                          ItemTemplate="{StaticResource LabelOptionTemplate}" Margin="0,8,0,8" MinWidth="320" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Taille du fichier :" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="−" Style="{StaticResource GhostButton}" Command="{Binding DecreaseDiskSizeCommand}" MinWidth="36"/>
                                    <TextBlock Text="{Binding DiskSizeText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0" MinWidth="56" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource GhostButton}" Command="{Binding IncreaseDiskSizeCommand}" MinWidth="36"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DiskWriteText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SustainedEnabled}" Margin="0,0,0,12"
                                  Content="Phase soutenue des tests processeur (3 min de charge continue avant la seconde mesure)"/>

                        <TextBlock Text="{Binding PreconditionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ThermalText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EstimatedDurationText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Démarrer confirme à chaque fois (« Non » par défaut) ; Arrêter est toujours visible. -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Démarrer" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
                            <Button Content="Arrêter" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}"/>
                        </StackPanel>
                        <TextBox Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding Status, Mode=OneWay}"
                                 Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- ============ En cours ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="En cours" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Phase}" Style="{StaticResource Body}" Margin="0,8,0,4" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LiveValueText}" Style="{StaticResource Body}" Margin="12,0,0,0"
                                       Visibility="{Binding LiveValueText, Converter={StaticResource NullToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LiveSensorsText}" Style="{StaticResource Caption}" Margin="0,8,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Température CPU" Style="{StaticResource Caption}"/>
                                <controls:Sparkline Series="{Binding TempHistory}" Height="56" LineBrush="{StaticResource WarnBrush}" FillBrush="Transparent" AutoScale="True" MinimumScale="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="Puissance CPU" Style="{StaticResource Caption}"/>
                                <controls:Sparkline Series="{Binding PowerHistory}" Height="56" LineBrush="{StaticResource AccentBrush}" FillBrush="Transparent" AutoScale="True" MinimumScale="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Fréquence CPU max" Style="{StaticResource Caption}"/>
                                <controls:Sparkline Series="{Binding ClockHistory}" Height="56" LineBrush="{StaticResource SuccessBrush}" FillBrush="Transparent" AutoScale="True" MinimumScale="1000"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Résultats de la session ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Résultats" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="1000 points = la machine de référence (références provisoires, à calibrer). Les unités physiques restent la mesure ; les points ne se comparent qu'entre sessions de la même version du bench."/>
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetTile}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PointsText}" Style="{StaticResource StatValue}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                            <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,8" Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}">
                                                <TextBox Style="{StaticResource SelectableCaption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{Binding Warning, Mode=OneWay}"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource SelectableBody}" Text="{Binding Mode=OneWay}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Style="{StaticResource SelectableCaption}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding DetailText, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Historique ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Historique" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Text="Une session par fichier dans le sous-dossier bench du dossier de données de l'app, la plus récente en premier."/>
                        <TextBlock Text="Aucune session enregistrée sur ce PC." Style="{StaticResource Caption}"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBox Style="{StaticResource SelectableBody}" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}"
                                   Visibility="{Binding HistoryStatus, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Diagnostic (#12) ==================== -->
            <ContentControl Content="{Binding Diagnostic}" ContentTemplate="{StaticResource ComingSoonBlock}"
                            Visibility="{Binding SelectedSection.Key, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=diagnostic}"/>

            <!-- ==================== Technicien (#13) ==================== -->
            <ContentControl Content="{Binding Technician}" ContentTemplate="{StaticResource ComingSoonBlock}"
                            Visibility="{Binding SelectedSection.Key, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=technician}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
