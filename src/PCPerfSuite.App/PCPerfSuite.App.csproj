<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PCPerfSuite.ico</ApplicationIcon>
    <AssemblyName>PCPerfSuite</AssemblyName>
    <RootNamespace>PCPerfSuite.App</RootNamespace>
    <!-- L'app a besoin des droits admin pour lire/écrire les capteurs matériel et les réglages système -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aussi en ressource WPF : ApplicationIcon ne pose que l'icône Win32 de l'exe (celle que
         charge la zone de notification), alors que Window.Icon a besoin d'une ressource adressable. -->
    <Resource Include="PCPerfSuite.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCPerfSuite.Core\PCPerfSuite.Core.csproj" />
  </ItemGroup>

</Project>
