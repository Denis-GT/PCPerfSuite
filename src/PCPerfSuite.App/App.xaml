<Application x:Class="PCPerfSuite.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PCPerfSuite.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:PercentToStarConverter x:Key="PercentToStar"/>
            <conv:PercentRemainderToStarConverter x:Key="PercentRemainderToStar"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>
            <conv:NullableNumberToDoubleConverter x:Key="NullableToDouble"/>
            <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
            <conv:NullableMetricConverter x:Key="Metric"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
