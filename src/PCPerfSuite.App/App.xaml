<Application x:Class="PCPerfSuite.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PCPerfSuite.App.Converters"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- OnExplicitShutdown : la croix ne ferme plus l'app, elle la range dans la zone de notification,
         donc plus aucune fermeture de fenêtre ne doit décider de l'arrêt (OnMainWindowClose tuerait
         l'app au premier masquage, OnLastWindowClose la laisserait en vie tant que l'overlay est
         affiché). Conséquence : toute sortie passe par MainWindow.Closed, qui libère le ViewModel
         puis appelle Shutdown. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
                <ResourceDictionary Source="Styles/Menus.xaml"/>
                <ResourceDictionary Source="Styles/Overlay.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:PercentToStarConverter x:Key="PercentToStar"/>
            <conv:PercentRemainderToStarConverter x:Key="PercentRemainderToStar"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>
            <conv:NullableNumberToDoubleConverter x:Key="NullableToDouble"/>
            <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
            <conv:NullableMetricConverter x:Key="Metric"/>
            <conv:DiskHealthStatusToBrushConverter x:Key="DiskHealthBrush"/>
            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVisibility"/>
            <conv:RtssStatusConverter x:Key="RtssStatus"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <conv:IntensityToBlueBrushConverter x:Key="IntensityBrush"/>
            <conv:BoolToDimOpacityConverter x:Key="DimOpacity"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <!-- Display (plutôt que Ideal, le défaut WPF) aligne le texte sur la grille de
                     pixels de l'écran au lieu de l'optimiser pour un rendu façon impression :
                     nettement plus net à l'écran, surtout en mise à l'échelle DPI non entière. -->
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
