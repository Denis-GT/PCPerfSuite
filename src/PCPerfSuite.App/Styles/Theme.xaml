<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <!-- ============================================================ -->
    <!-- Palette "Liquid Glass" : couleurs système vives façon Apple   -->
    <!-- (dark mode) sur des surfaces translucides façon verre dépoli. -->
    <!-- ============================================================ -->
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentColor2">#5FE0C7</Color>
    <Color x:Key="WarnColor">#FF9F0A</Color>
    <Color x:Key="DangerColor">#FF453A</Color>
    <Color x:Key="TextPrimaryColor">#F2F4FA</Color>
    <Color x:Key="TextSecondaryColor">#ACB4C8</Color>

    <!-- Halo décoratif en haut à gauche de la fenêtre, et sa fin transparente. -->
    <Color x:Key="AccentGlowColor">#332A84FF</Color>
    <Color x:Key="AccentGlowFadeColor">#00161A28</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush2" Color="{StaticResource AccentColor2}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="SuccessColor">#30D158</Color>
    <Color x:Key="TextTertiaryColor">#7C8499</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <!-- Couches d'interaction : un voile blanc plus ou moins dense posé sur n'importe quelle surface. -->
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="StrongHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#332A84FF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#26FFFFFF"/>

    <!-- Champs de saisie et popups. Les popups sont des fenêtres à part : fond presque opaque pour que
         le texte y reste net (cf. Menus.xaml). -->
    <SolidColorBrush x:Key="InputHoverBrush" Color="#D93A4258"/>
    <SolidColorBrush x:Key="InputPressedBrush" Color="#E6252B3C"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#F51A1E2C"/>

    <!-- Variantes au survol / à l'appui de l'accent. -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E96FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0A6FE0"/>

    <!-- Fonds teintés (badges, encarts d'avertissement) et leurs liserés. -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#260A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#590A84FF"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#1FFF9F0A"/>
    <SolidColorBrush x:Key="WarnSoftBorderBrush" Color="#59FF9F0A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FFF453A"/>
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#59FF453A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F30D158"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#5930D158"/>

    <!-- Logo : dégradé des deux accents. -->
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor2}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Police d'icônes : Segoe Fluent Icons (Windows 11), repli sur Segoe MDL2 Assets (Windows 10),
         qui partagent les mêmes codes pour les glyphes utilisés ici. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Gabarit : mêmes marges et même largeur utile sur toutes les pages. -->
    <Thickness x:Key="PagePadding">32,28,32,28</Thickness>
    <sys:Double x:Key="PageMaxWidth">1200</sys:Double>
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>

    <!-- Fond de fenêtre : dégradé sombre façon "wallpaper flouté" derrière le verre.
         Sert de secours visuel si le fond Mica/Acrylic natif (MainWindow.xaml.cs) n'est pas
         disponible (Windows < 11 22H2) : la fenêtre reste alors sombre et lisible, juste sans
         flou natif du bureau. -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0C0E16" Offset="0"/>
        <GradientStop Color="#171A2C" Offset="0.55"/>
        <GradientStop Color="#1B1330" Offset="1"/>
    </LinearGradientBrush>

    <!-- Panneau latéral : verre un peu plus opaque pour ancrer la navigation. -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#D4131624"/>

    <!-- Fond très sombre et opaque, façon scène de jeu (aperçu de l'overlay). -->
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#0B0D14"/>

    <!-- Cartes/surfaces : verre dépoli avec un léger reflet (plus clair en haut-gauche). -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BE2A3040" Offset="0"/>
        <GradientStop Color="#BE191D2B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#CC2E3548"/>

    <!-- Bordure "verre" : liseré clair qui s'estompe, comme la lumière sur un bord incurvé. -->
    <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Remplissage des jauges et des barres de progression : l'accent légèrement éclairci vers la
         droite. Le relief vient du dégradé, jamais d'un Effect : tout Effect force un rendu bitmap
         intermédiaire qui désactive le ClearType du texte voisin. -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="#4FA8FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typo. ClearTypeHint=Enabled : garde un rendu de texte net même à l'intérieur d'un
         parent semi-transparent/animé (survol, désactivé) qui forcerait sinon un antialiasing
         en niveaux de gris plus flou. -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>

    <!-- Petit titre de section en capitales, couleur d'accent (au-dessus d'un groupe de cartes). -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <!-- En-tête de colonne d'un tableau. -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <!-- Valeur d'une tuile de mesure (plus petite que MetricValue, pour les grilles de relevés). -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>
    <!-- Glyphe de la police d'icônes. -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- Texte informatif sélectionnable. WPF ne sait pas sélectionner le texte d'un TextBlock : on passe
         par un champ en lecture seule dépouillé de tout ce qui le ferait passer pour une saisie (cadre,
         fond, marge intérieure, curseur de saisie, tabulation). À réserver aux textes qu'on veut pouvoir
         copier — explications, statuts, chemins, rapport de compatibilité — et surtout pas aux valeurs
         des tuiles, qui doivent rester de simples TextBlock. -->
    <Style x:Key="SelectableCaption" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <!-- Menu réduit à « Copier » : celui d'un TextBox afficherait Couper et Coller, grisés et sans objet. -->
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Copier" Command="ApplicationCommands.Copy"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectableBody" TargetType="TextBox" BasedOn="{StaticResource SelectableCaption}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Carte en verre dépoli. Pas d'Effect ici (rendrait le texte contenu flou) : la profondeur
         vient uniquement du dégradé de fond + de la bordure lumineuse. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>

    <!-- Surface secondaire posée DANS une carte (ligne de profil, tuile de mesure...). -->
    <Style x:Key="InsetTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Encarts d'avertissement : fond teinté et liseré de la couleur du message. -->
    <Style x:Key="CalloutWarn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style x:Key="CalloutDanger" TargetType="Border" BasedOn="{StaticResource CalloutWarn}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- Pastilles d'information. Le texte (BadgeText) hérite sa couleur de la pastille. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="BadgeWarn" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnSoftBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style x:Key="BadgeAccent" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush2}"/>
    </Style>
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessSoftBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>

    <!-- Anneau de focus clavier des boutons (affiché seulement en navigation au clavier). -->
    <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="20" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton accent (rempli, façon bouton système Apple : libellé blanc) -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="17"/>
                        <!-- Voile de survol/appui posé sur la couleur du bouton, quelle qu'elle soit (DangerButton compris). -->
                        <Border x:Name="Veil" CornerRadius="17" Background="Transparent"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Background" Value="{StaticResource StrongHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Background" Value="#26000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton discret (verre transparent) -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton-icône carré (actions secondaires compactes). Le contenu est un glyphe de IconFont. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Bouton à deux états (« Figer » dans Processus) : le rendu de GhostButton, plus un état actif
         teinté d'avertissement. Un bouton plutôt qu'un interrupteur : c'est une action qu'on déclenche
         et qu'on annule, pas un réglage qu'on laisse posé. -->
    <Style x:Key="ToggleActionButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <!-- Ordre significatif : l'état actif est déclaré après le survol pour l'emporter,
                         puis le survol d'un bouton actif l'emporte sur les deux. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarnSoftBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#33FF9F0A"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Élément de la navigation latérale : icône + libellé, barre d'accent à gauche quand il est actif.
         Le DataContext est un NavEntry (Title, Icon). -->
    <Style x:Key="NavListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="10,1">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Grid.Column="0" Text="{Binding Icon}" Style="{StaticResource Icon}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" RenderOptions.ClearTypeHint="Enabled"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Visibility="Hidden"/>
                    </Grid>
                    <!-- Ordre significatif : la sélection, déclarée après le survol, l'emporte. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton de la barre latérale hors de la liste (Paramètres, en bas) : même rendu que NavListItem.
         Content est un NavEntry (Title, Icon) ; Tag à True le montre actif. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="10,1">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Grid.Column="0" Style="{StaticResource Icon}" HorizontalAlignment="Left"
                                           Text="{Binding Content.Icon, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <TextBlock Grid.Column="1" FontSize="13.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" RenderOptions.ClearTypeHint="Enabled"
                                           Text="{Binding Content.Title, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Visibility="Hidden"/>
                    </Grid>
                    <!-- Ordre significatif : l'état actif, déclaré après le survol, l'emporte. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sélecteur segmenté : des RadioButton côte à côte dans un SegmentedGroup ; l'option active prend
         l'accent (même rendu que PillSelector, pour des choix liés à une propriété enum). -->
    <Style x:Key="SegmentedGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SegmentFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SegmentFocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tuile cochable (choix multiple détaillé, ex. disques à analyser). La pastille de sélection est posée
         en haut à droite PAR-DESSUS le contenu, qui garde ainsi toute la largeur pour ses jauges : c'est
         au contenu de laisser libre ce coin (20 px de large). -->
    <Style x:Key="TileFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="17" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SelectableTile" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            RenderOptions.ClearTypeHint="Enabled">
                        <Grid>
                            <ContentPresenter/>
                            <Grid Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="#40FFFFFF" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                <Path x:Name="Tick" Data="M 5.75,10.25 L 8.75,13.25 L 14.25,6.75" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Ordre significatif : l'état coché l'emporte sur le survol, puis le survol d'une tuile cochée
                         l'emporte sur les deux pour qu'elle réagisse elle aussi au pointeur. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="#8CFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#3D0A84FF"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Curseur (implicite) : piste arrondie de 6 px, remplie du dégradé d'accent jusqu'au curseur,
         et poignée blanche pleine posée dessus. L'accent est porté par la piste et non par la poignée :
         l'ancienne poignée à anneau bleu faisait une cible chargée pour un contrôle qu'on trouve
         partout dans l'app. -->
    <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <!-- Taille fixe : c'est la marge du disque intérieur qui varie au survol, pour que la piste ne
             se réorganise pas pendant qu'on fait glisser la poignée. -->
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Halo" Fill="{StaticResource AccentBrush}" Opacity="0" Margin="-5"/>
                        <!-- Repère de focus clavier : un anneau net plutôt qu'un flou. Le Thumb n'étant
                             pas focalisable, l'état est lu sur le Slider parent. -->
                        <Ellipse x:Name="Ring" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Margin="-3" Opacity="0"/>
                        <Ellipse x:Name="Disc" Fill="White" Margin="1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="5" ShadowDepth="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="Disc" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.28"/>
                            <Setter TargetName="Disc" Property="Margin" Value="0"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackFill}"
                                              Background="{StaticResource AccentFillBrush}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackFill}"
                                              Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <!-- Le repère de focus clavier est porté par le pouce lui-même (SliderThumb). -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Infobulle (implicite). Popup = fenêtre à part : fond quasi opaque pour garder le texte net. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" MaxWidth="360" RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barre de progression (implicite), avec un mode indéterminé animé. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <!-- Même dégradé que les jauges MeterBar, pour que les deux se ressemblent. -->
        <Setter Property="Foreground" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        <Border x:Name="Runner" CornerRadius="2" Background="{TemplateBinding Foreground}" Width="90"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RunnerShift" X="-90"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunnerAnimation">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X"
                                                         From="-90" To="1400" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RunnerAnimation"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- En-tête de page : titre, sous-titre, et à droite le contenu du contrôle (actions de la page). -->
    <Style TargetType="controls:PageHeader">
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H1}" FontSize="26"/>
                            <!-- Sélectionnable : ces sous-titres expliquent ce que fait la page et ce que
                                 le PC sait faire, c'est le genre de phrase qu'on recopie dans un message. -->
                            <TextBox x:Name="SubtitleText" Text="{TemplateBinding Subtitle}"
                                     Style="{StaticResource SelectableCaption}" FontSize="12.5"
                                     Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interrupteur (toggle) façon iOS : piste accent + curseur blanc. Aucune lueur accent : ces
         interrupteurs sont nombreux sur certains écrans, et un halo par interrupteur allumé chargeait
         la page. Le contraste vient de la piste pleine et du liseré. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fond transparent : toute la zone du contrôle reste cliquable, pas seulement la piste. -->
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <!-- Voile de survol posé sur la piste, quelle que soit sa couleur (éteinte ou accent). -->
                        <Border x:Name="Veil" Width="42" Height="24" CornerRadius="12" Background="Transparent"/>
                        <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                                HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="3" ShadowDepth="1"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Background" Value="{StaticResource StrongHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anneau de focus clavier des cases à cocher. Passer par FocusVisualStyle (et non un trigger
         IsKeyboardFocused) : WPF ne l'affiche qu'en navigation au clavier, pas après un clic. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Case à cocher standard (implicite). Les CheckBox avec Style="{StaticResource ToggleSwitch}"
         ne sont pas concernées : un Style explicite remplace le style implicite. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CheckBoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fond transparent : l'écart entre la case et le libellé reste cliquable.
                         ClearTypeHint : garde le libellé net sous l'opacité réduite de l'état désactivé. -->
                    <Grid x:Name="Root" Background="Transparent" RenderOptions.ClearTypeHint="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="Box" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Fill" CornerRadius="5" Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed"/>
                            <Path x:Name="CheckMark" Data="M 4.75,9.25 L 7.75,12.25 L 13.25,5.75" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="White" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{TemplateBinding Padding}" Focusable="False"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <!-- Ordre significatif : l'état coché, déclaré après le survol/l'appui, masque la case grise. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#66FFFFFF"/>
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource InputPressedBrush}"/>
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Barre de défilement fine et translucide, cohérente avec le reste du thème verre. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3CFFFFFF" CornerRadius="5" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Liste déroulante en verre. Style IMPLICITE : le template par défaut de WPF est clair, et une
         liste oubliée sans style détonnait franchement sur le thème sombre (c'était le cas du « Mode
         boost » de l'onglet Processeur). Les clés GlassComboBox / GlassComboBoxItem restent pour les
         vues qui les nomment déjà. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" Margin="3,1"
                            RenderOptions.ClearTypeHint="Enabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <!-- Coche de l'option retenue : au clavier, survol et sélection se peignent tous
                                 deux en fond, et rien ne distinguerait plus l'option en cours. -->
                            <Path x:Name="Tick" Grid.Column="1" Margin="12,0,2,0" Visibility="Collapsed"
                                  Data="M 0,4 L 3.5,7.5 L 9,1" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource StrongHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"/>

    <!-- Contenu d'une option dont le modèle expose Label. À poser en ItemTemplate, et NON en
         DisplayMemberPath : DisplayMemberPath ne pilote que les ComboBoxItem de la liste déroulée. La
         case fermée, elle, est un ContentPresenter alimenté par SelectionBoxItemTemplate, qui dérive
         d'ItemTemplate — laissé vide, il retombe sur ToString() de l'objet, et un record y affiche
         toute sa structure. -->
    <DataTemplate x:Key="LabelOptionTemplate">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Marge droite large : le chevron est posé par-dessus, le libellé ne doit pas passer dessous. -->
        <Setter Property="Padding" Value="12,7,34,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource ControlRadius}">
                                        <Path x:Name="Chevron" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource TextSecondaryBrush}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <!-- Ordre significatif : la liste ouverte, déclarée après le survol, l'emporte. -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputPressedBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- PopupAnimation="None" : l'animation est faite à la main juste en dessous, pour que la
                             liste se déroule depuis le champ au lieu d'apparaître en fondu. -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border x:Name="PopupCard" Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="2" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    RenderTransformOrigin="0.5,0">
                                <!-- Origine en haut : la liste grandit vers le bas, comme si elle sortait du champ. -->
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="1"/>
                                </Border.RenderTransform>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Le déroulé. Pas d'animation à la fermeture : WPF retire le popup sans attendre,
                             elle serait coupée à la première image. -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PopupCard"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PopupCard" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

    <!-- Pastille de couleur (choix des couleurs de l'overlay) : le DataContext du bouton est le choix
         de couleur, d'où le DataTrigger sur IsSelected pour afficher l'anneau de sélection. -->
    <Style x:Key="ColorSwatch" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Margin="3.5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="Dot" Property="Margin" Value="5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sélecteur en pilules (cadence de rafraîchissement, position de l'overlay...) : une ListBox
         horizontale dont l'élément sélectionné prend la couleur d'accent. -->
    <Style x:Key="PillItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,5" Margin="1"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillSelector" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PillItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Champ de saisie en verre (cadence de rafraîchissement, nom de profil...). -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Champ numérique avec son unité DANS le cadre : « 1000 » suivi de « ms » à l'extérieur laissait
         deux vides, un de chaque côté du nombre. Ici le nombre est collé à son unité et le cadre est
         taillé pour la valeur la plus longue (60000 ms), pas plus. Poser Tag="ms" sur le champ. -->
    <Style x:Key="UnitTextBox" TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="8,5,0,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Unit" Grid.Column="1" Text="{TemplateBinding Tag}" VerticalAlignment="Center"
                                       Margin="4,0,10,0" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                       RenderOptions.ClearTypeHint="Enabled"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Unit" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ligne dense d'un tableau (onglet Processus). Template complet : celui de WPF peint la sélection avec
         les pinceaux SystemColors, un bleu clair système qui jurerait avec le thème verre. -->
    <Style x:Key="ListRowItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="0,1"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter/>
                    </Border>
                    <!-- Ordre significatif : la sélection est déclarée après le survol pour l'emporter quand
                         les deux sont vrais. -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- En-tête de colonne triable : un bouton plat qui s'aligne comme sa colonne. -->
    <Style x:Key="ColumnHeaderButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action destructrice (pendant de DangerMenuItem, qui ne vaut que pour les menus). -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

</ResourceDictionary>
