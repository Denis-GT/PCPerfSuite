<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PCPerfSuite.App.Controls">

    <!-- Ligne d'overlay, partagée par l'aperçu de l'onglet et la fenêtre d'overlay (DataContext : OverlayLine).
         Colonnes fixes : libellé, puis pour chaque métrique la valeur calée à droite et son unité. Chaque colonne
         prend la largeur de la plus large vue jusqu'ici, sur toutes les lignes (StickyWidth, dont la portée est
         posée par le conteneur) : les valeurs ne se décalent plus d'un relevé à l'autre. Les espacements sont des
         espaces, pour suivre la taille de police. -->
    <DataTemplate x:Key="OverlayLineTemplate">
        <StackPanel Orientation="Horizontal" TextElement.FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
            <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" controls:StickyWidth.Group="label"/>
            <ItemsControl ItemsSource="{Binding Cells}" TextElement.Foreground="{Binding ValueBrush}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Prefix, StringFormat='  {0}'}"
                                       Foreground="{Binding DataContext.LabelBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Prefix}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="  "/>
                            <TextBlock Text="{Binding Value}" TextAlignment="Right"
                                       controls:StickyWidth.Group="{Binding ValueGroup}"/>
                            <TextBlock Text="{Binding Unit}" controls:StickyWidth.Group="{Binding UnitGroup}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
