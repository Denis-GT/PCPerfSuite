<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Appels ADLX (AMD) par tables de fonctions natives et structures IGCL (Intel) à tableaux fixes -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Capteurs matériel + écriture ventilateurs : moteur open-source utilisé par HWiNFO-like tools -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <!-- WMI (Storage Management) pour l'état de santé des disques, indépendant du fabricant -->
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Module IntelMSR de PawnIO.Modules 0.2.11 (LGPL-2.1, signé par namazso), livré à part dans PawnIO\ à côté de
         l'exe pour rester remplaçable (décision D1) : celui de LibreHardwareMonitorLib 0.9.6 n'écrit pas les MSR. -->
    <Content Include="Hardware\Cpu\PawnIoModules\IntelMSR.bin;Hardware\Cpu\PawnIoModules\COPYING.LGPL-2.1.txt;Hardware\Cpu\PawnIoModules\LISEZMOI.txt">
      <Link>PawnIO\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Échéancier des capteurs (SensorReadSchedule), interne mais testé -->
    <InternalsVisibleTo Include="PCPerfSuite.Core.Tests" />
  </ItemGroup>

</Project>
